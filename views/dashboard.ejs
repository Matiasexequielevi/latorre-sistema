<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    La Torre | Inicio
  </title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f3f4f6;
      color: #111827;

      font-family:
        "Segoe UI",
        Arial,
        sans-serif;
    }

    .topbar {
      min-height: 72px;
      background: #111827;
      color: white;
      padding: 0 26px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;
    }

    .brand h1 {
      margin: 0;
      font-size: 24px;
    }

    .brand span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .usuario {
      display: flex;
      align-items: center;
      gap: 16px;
      text-align: right;
    }

    .usuario strong {
      display: block;
      font-size: 14px;
    }

    .usuario span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .logout {
      border: 1px solid #374151;
      border-radius: 9px;
      padding: 9px 12px;
      background: #1f2937;
      color: white;
      cursor: pointer;
    }

    .layout {
      display: flex;
      min-height: calc(100vh - 72px);
    }

    .sidebar {
      width: 235px;
      flex-shrink: 0;
      background: white;

      border-right:
        1px solid #e5e7eb;

      padding: 20px 14px;
    }

    .sidebar a {
      display: block;
      margin-bottom: 5px;
      padding: 12px 14px;
      border-radius: 9px;

      text-decoration: none;

      color: #374151;

      font-size: 14px;
      font-weight: 600;
    }

    .sidebar a:hover {
      background: #f3f4f6;
    }

    .sidebar a.active {
      background: #111827;
      color: white;
    }

    .separator {
      height: 1px;
      margin: 14px 8px;
      background: #e5e7eb;
    }

    .content {
      flex: 1;
      min-width: 0;
      padding: 28px;
    }

    .cabecera {
      margin-bottom: 25px;
    }

    .cabecera h2 {
      margin: 0;
      font-size: 28px;
    }

    .cabecera p {
      margin: 7px 0 0;
      color: #6b7280;
    }

    /* =====================================
       TARJETAS PRINCIPALES
    ===================================== */

    .cards {
      display: grid;

      grid-template-columns:
        repeat(4, minmax(0, 1fr));

      gap: 16px;
      margin-bottom: 25px;
    }

    .card {
      background: white;

      border:
        1px solid #e5e7eb;

      border-radius: 15px;

      padding: 20px;
    }

    .card .label {
      color: #6b7280;

      font-size: 12px;
      font-weight: 700;

      text-transform: uppercase;
    }

    .card .valor {
      margin-top: 10px;

      font-size: 28px;
      font-weight: 800;
    }

    .card .detalle {
      margin-top: 6px;

      color: #9ca3af;

      font-size: 12px;
    }

    .card-alerta {
      border-color: #fed7aa;
      background: #fffdf9;
    }

    .card-alerta .valor {
      color: #c2410c;
    }

    /* =====================================
       STOCK
    ===================================== */

    .titulo-seccion {
      margin: 0 0 12px;

      font-size: 16px;
      font-weight: 700;
    }

    .stock-grid {
      display: grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap: 16px;

      margin-bottom: 25px;
    }

    .stock-card {
      background: white;

      border:
        1px solid #e5e7eb;

      border-radius: 15px;

      padding: 18px;
    }

    .stock-card strong {
      display: block;
      font-size: 16px;
    }

    .stock-card .cantidad {
      margin-top: 9px;

      font-size: 27px;
      font-weight: 800;
    }

    .stock-card .detalle {
      margin-top: 5px;

      color: #9ca3af;

      font-size: 12px;
    }

    /* =====================================
       PANELES
    ===================================== */

    .panel {
      margin-bottom: 22px;

      background: white;

      border:
        1px solid #e5e7eb;

      border-radius: 15px;

      overflow: hidden;
    }

    .panel-header {
      min-height: 58px;

      padding: 16px 20px;

      border-bottom:
        1px solid #e5e7eb;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;
    }

    .panel-header strong {
      font-size: 16px;
    }

    .panel-header span {
      color: #6b7280;
      font-size: 12px;
    }

    .panel-link {
      color: #374151;

      font-size: 12px;
      font-weight: 700;

      text-decoration: none;
    }

    .panel-link:hover {
      text-decoration: underline;
    }

    .panel-alerta {
      border-color: #fed7aa;
    }

    .panel-alerta .panel-header {
      background: #fff7ed;
    }

    /* =====================================
       TABLAS
    ===================================== */

    .table-wrapper {
      overflow-x: auto;
    }

    table {
      width: 100%;

      border-collapse: collapse;
    }

    th,
    td {
      padding: 13px 16px;

      border-bottom:
        1px solid #f0f1f3;

      text-align: left;

      font-size: 13px;

      white-space: nowrap;
    }

    th {
      color: #6b7280;

      background: #fafafa;

      font-size: 11px;
      text-transform: uppercase;
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    tbody tr:hover {
      background: #fafafa;
    }

    td strong {
      font-weight: 700;
    }

    .codigo {
      color: #6b7280;
      font-size: 11px;
    }

    .monto {
      font-weight: 800;
    }

    /* =====================================
       BADGES
    ===================================== */

    .badge {
      display: inline-block;

      padding: 5px 8px;

      border-radius: 7px;

      font-size: 10px;
      font-weight: 800;
    }

    .badge-sucursal {
      background: #eff8ff;
      color: #175cd3;
    }

    .badge-stock {
      background: #fff7ed;
      color: #c2410c;
    }

    .badge-movimiento {
      background: #f3f4f6;
      color: #374151;
    }

    /* =====================================
       DOS COLUMNAS
    ===================================== */

    .dashboard-grid {
      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);

      gap: 22px;
    }

    /* =====================================
       VACÍO
    ===================================== */

    .vacio {
      padding: 35px;

      text-align: center;

      color: #9ca3af;

      font-size: 13px;
    }

    /* =====================================
       RESPONSIVE
    ===================================== */

    @media (
      max-width: 1200px
    ) {

      .cards {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .dashboard-grid {
        grid-template-columns: 1fr;
      }

    }

    @media (
      max-width: 850px
    ) {

      .stock-grid {
        grid-template-columns: 1fr;
      }

    }

    @media (
      max-width: 760px
    ) {

      .sidebar {
        display: none;
      }

      .content {
        padding: 18px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .topbar {
        padding: 14px 18px;
      }

      .usuario span {
        display: none;
      }

    }

  </style>

</head>

<body>

<header class="topbar">

  <div class="brand">

    <h1>
      LA TORRE
    </h1>

    <span>
      Sistema Multisucursal
    </span>

  </div>

  <div class="usuario">

    <div>

      <strong>
        <%= usuario.nombre %>
      </strong>

      <span>

        <% if (
          usuario.rol === "dueno"
        ) { %>

          Dueño · Todas las ubicaciones

        <% } else { %>

          <%= usuario.ubicacion %>

        <% } %>

      </span>

    </div>

    <form
      action="/logout"
      method="POST"
    >

      <button
        class="logout"
        type="submit"
      >
        Salir
      </button>

    </form>

  </div>

</header>

<div class="layout">

  <!-- =====================================
       MENÚ
  ====================================== -->

  <aside class="sidebar">

    <a
      href="/dashboard"
      class="active"
    >
      Inicio
    </a>

    <a href="/caja">
      Caja
    </a>

      <a href="/cajas">Cajas / Arqueo</a>

    <a href="/ventas">
      Ventas
    </a>

    <a href="/presupuestos">
      Presupuestos
    </a>

    <div class="separator"></div>

    <a href="/productos">
      Productos
    </a>

    <a href="/stock">
      Stock
    </a>

    <a href="/transferencias">
      Transferencias
    </a>

    <a href="/ingresos">
      Ingreso de mercadería
    </a>

    <div class="separator"></div>

    <a href="/reportes">
      Reportes
    </a>

    <a href="/movimientos">
      Historial
    </a>

    <% if (
      usuario.rol === "dueno"
    ) { %>

      <a href="/tarjetas">
        Tarjetas y cuotas
      </a>

      <div class="separator"></div>

      <a href="/usuarios">
        Usuarios
      </a>

      <a href="/importacion">
        Importación inicial
      </a>

    <% } %>

  </aside>

  <!-- =====================================
       CONTENIDO
  ====================================== -->

  <main class="content">

    <div class="cabecera">

      <h2>
        Inicio
      </h2>

      <p>

        <% if (
          usuario.rol === "dueno"
        ) { %>

          Resumen general de La Torre

        <% } else { %>

          Resumen de
          <strong>
            <%= usuario.ubicacion %>
          </strong>

        <% } %>

      </p>

    </div>

    <!-- =====================================
         RESUMEN
    ====================================== -->

    <section class="cards">

      <div class="card">

        <div class="label">
          Ventas de hoy
        </div>

        <div class="valor">

          $<%= Number(
            resumen.ventasHoy
          ).toLocaleString(
            "es-AR",
            {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }
          ) %>

        </div>

        <div class="detalle">

          <%= resumen.cantidadVentasHoy %>

          <% if (
            Number(
              resumen.cantidadVentasHoy
            ) === 1
          ) { %>

            venta realizada

          <% } else { %>

            ventas realizadas

          <% } %>

        </div>

      </div>

      <div class="card">

        <div class="label">
          Productos
        </div>

        <div class="valor">
          <%= resumen.cantidadProductos %>
        </div>

        <div class="detalle">
          Productos activos
        </div>

      </div>

      <div class="card">

        <div class="label">
          Stock total
        </div>

        <div class="valor">

          <% if (
            usuario.rol === "dueno"
          ) { %>

            <%= resumen.stockTotal %>

          <% } else if (
            usuario.ubicacion === "Florida Local"
          ) { %>

            <%= resumen.stockFlorida %>

          <% } else if (
            usuario.ubicacion === "Delfín Gallo Local"
          ) { %>

            <%= resumen.stockDelfin %>

          <% } else { %>

            0

          <% } %>

        </div>

        <div class="detalle">

          <% if (
            usuario.rol === "dueno"
          ) { %>

            Todas las ubicaciones

          <% } else { %>

            Stock de la sucursal

          <% } %>

        </div>

      </div>

      <div
        class="card
        <%= Number(resumen.cantidadStockBajo) > 0 ? 'card-alerta' : '' %>"
      >

        <div class="label">
          Stock bajo
        </div>

        <div class="valor">
          <%= resumen.cantidadStockBajo %>
        </div>

        <div class="detalle">
          Productos para revisar
        </div>

      </div>

    </section>

    <!-- =====================================
         STOCK POR UBICACIÓN
         SOLO DUEÑO
    ====================================== -->

    <% if (
      usuario.rol === "dueno"
    ) { %>

      <h3 class="titulo-seccion">
        Stock por ubicación
      </h3>

      <section class="stock-grid">

        <div class="stock-card">

          <strong>
            Florida
          </strong>

          <div class="cantidad">
            <%= resumen.stockFlorida %>
          </div>

          <div class="detalle">
            Unidades disponibles
          </div>

        </div>

        <div class="stock-card">

          <strong>
            Delfín Gallo
          </strong>

          <div class="cantidad">
            <%= resumen.stockDelfin %>
          </div>

          <div class="detalle">
            Unidades disponibles
          </div>

        </div>

        <div class="stock-card">

          <strong>
            Depósito
          </strong>

          <div class="cantidad">
            <%= resumen.stockDeposito %>
          </div>

          <div class="detalle">
            Unidades disponibles
          </div>

        </div>

      </section>

    <% } %>

    <!-- =====================================
         STOCK BAJO
    ====================================== -->

    <% if (
      stockBajo &&
      stockBajo.length > 0
    ) { %>

      <section class="panel panel-alerta">

        <div class="panel-header">

          <div>

            <strong>
              Stock bajo
            </strong>

            <span>
              · Requiere atención
            </span>

          </div>

          <a
            href="/stock"
            class="panel-link"
          >
            Ver stock completo
          </a>

        </div>

        <div class="table-wrapper">

          <table>

            <thead>

              <tr>

                <th>
                  Producto
                </th>

                <th>
                  Código
                </th>

                <th>
                  Ubicación
                </th>

                <th>
                  Stock
                </th>

                <th>
                  Mínimo
                </th>

              </tr>

            </thead>

            <tbody>

              <% stockBajo.forEach(
                item => {
              %>

                <tr>

                  <td>
                    <strong>
                      <%= item.descripcion %>
                    </strong>
                  </td>

                  <td class="codigo">
                    <%= item.codigo_interno || "-" %>
                  </td>

                  <td>

                    <span class="badge badge-sucursal">
                      <%= item.ubicacion %>
                    </span>

                  </td>

                  <td>

                    <span class="badge badge-stock">
                      <%= item.cantidad %>
                    </span>

                  </td>

                  <td>
                    <%= item.stock_minimo %>
                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        </div>

      </section>

    <% } %>

    <!-- =====================================
         ÚLTIMAS VENTAS
    ====================================== -->

    <section class="panel">

      <div class="panel-header">

        <strong>
          Últimas ventas
        </strong>

        <a
          href="/ventas"
          class="panel-link"
        >
          Ver todas
        </a>

      </div>

      <% if (
        !ultimasVentas ||
        ultimasVentas.length === 0
      ) { %>

        <div class="vacio">
          Todavía no hay ventas registradas.
        </div>

      <% } else { %>

        <div class="table-wrapper">

          <table>

            <thead>

              <tr>

                <th>
                  Venta
                </th>

                <th>
                  Fecha
                </th>

                <th>
                  Cliente
                </th>

                <th>
                  Sucursal
                </th>

                <th>
                  Vendedor
                </th>

                <th>
                  Pago
                </th>

                <th>
                  Total
                </th>

              </tr>

            </thead>

            <tbody>

              <% ultimasVentas.forEach(
                venta => {
              %>

                <tr>

                  <td>

                    <strong>
                      #<%= venta.numero || venta.id %>
                    </strong>

                  </td>

                  <td>

                    <%= new Date(
                      venta.created_at
                    ).toLocaleString(
                      "es-AR"
                    ) %>

                  </td>

                  <td>
                    <%= venta.cliente || "Consumidor final" %>
                  </td>

                  <td>

                    <span class="badge badge-sucursal">
                      <%= venta.ubicacion %>
                    </span>

                  </td>

                  <td>
                    <%= venta.vendedor %>
                  </td>

                  <td>
                    <%= venta.forma_pago || "-" %>
                  </td>

                  <td class="monto">

                    $<%= Number(
                      venta.total
                    ).toLocaleString(
                      "es-AR",
                      {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                      }
                    ) %>

                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        </div>

      <% } %>

    </section>

    <!-- =====================================
         ÚLTIMOS MOVIMIENTOS
    ====================================== -->

    <section class="panel">

      <div class="panel-header">

        <strong>
          Últimos movimientos de stock
        </strong>

        <a
          href="/movimientos"
          class="panel-link"
        >
          Ver historial
        </a>

      </div>

      <% if (
        !ultimosMovimientos ||
        ultimosMovimientos.length === 0
      ) { %>

        <div class="vacio">
          Todavía no hay movimientos registrados.
        </div>

      <% } else { %>

        <div class="table-wrapper">

          <table>

            <thead>

              <tr>

                <th>
                  Fecha
                </th>

                <th>
                  Producto
                </th>

                <th>
                  Tipo
                </th>

                <th>
                  Ubicación
                </th>

                <th>
                  Cantidad
                </th>

                <th>
                  Stock
                </th>

                <th>
                  Usuario
                </th>

              </tr>

            </thead>

            <tbody>

              <% ultimosMovimientos.forEach(
                movimiento => {
              %>

                <tr>

                  <td>

                    <%= new Date(
                      movimiento.created_at
                    ).toLocaleString(
                      "es-AR"
                    ) %>

                  </td>

                  <td>

                    <strong>
                      <%= movimiento.producto %>
                    </strong>

                    <% if (
                      movimiento.codigo_interno
                    ) { %>

                      <div class="codigo">
                        <%= movimiento.codigo_interno %>
                      </div>

                    <% } %>

                  </td>

                  <td>

                    <span class="badge badge-movimiento">
                      <%= movimiento.tipo %>
                    </span>

                  </td>

                  <td>

                    <span class="badge badge-sucursal">
                      <%= movimiento.ubicacion %>
                    </span>

                  </td>

                  <td>
                    <strong>
                      <%= movimiento.cantidad %>
                    </strong>
                  </td>

                  <td>

                    <%= movimiento.stock_anterior %>
                    →
                    <strong>
                      <%= movimiento.stock_nuevo %>
                    </strong>

                  </td>

                  <td>
                    <%= movimiento.usuario || "-" %>
                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        </div>

      <% } %>

    </section>

  </main>

</div>

</body>

</html>