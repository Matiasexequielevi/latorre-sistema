<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    La Torre | Usuarios
  </title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f3f4f6;
      color: #111827;
      font-family: "Segoe UI", Arial, sans-serif;
    }

    .topbar {
      min-height: 72px;
      background: #111827;
      color: white;
      padding: 0 26px;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand h1 {
      margin: 0;
      font-size: 24px;
    }

    .brand span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .usuario-top {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .usuario-info {
      text-align: right;
    }

    .usuario-info strong {
      display: block;
      font-size: 14px;
    }

    .usuario-info span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .logout {
      border: 1px solid #374151;
      border-radius: 9px;
      padding: 9px 12px;
      background: #1f2937;
      color: white;
      cursor: pointer;
    }

    .layout {
      display: flex;
      min-height: calc(100vh - 72px);
    }

    .sidebar {
      width: 235px;
      flex-shrink: 0;
      background: white;
      border-right: 1px solid #e5e7eb;
      padding: 20px 14px;
    }

    .sidebar a {
      display: block;
      margin-bottom: 5px;
      padding: 12px 14px;
      border-radius: 9px;
      text-decoration: none;
      color: #374151;
      font-size: 14px;
      font-weight: 600;
    }

    .sidebar a:hover {
      background: #f3f4f6;
    }

    .sidebar a.active {
      background: #111827;
      color: white;
    }

    .separator {
      height: 1px;
      margin: 14px 8px;
      background: #e5e7eb;
    }

    .content {
      flex: 1;
      min-width: 0;
      padding: 28px;
    }

    .page-header h2 {
      margin: 0;
      font-size: 28px;
    }

    .page-header p {
      margin: 7px 0 0;
      color: #6b7280;
    }

    .alert {
      margin-top: 18px;
      padding: 13px 16px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
    }

    .alert-ok {
      background: #ecfdf3;
      color: #067647;
      border: 1px solid #abefc6;
    }

    .alert-error {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }

    .grid {
      display: grid;
      grid-template-columns:
        350px
        minmax(0, 1fr);
      gap: 18px;
      margin-top: 20px;
      align-items: start;
    }

    .card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 15px;
      padding: 20px;
    }

    .card h3 {
      margin: 0 0 8px;
      font-size: 18px;
    }

    .card-description {
      margin: 0 0 20px;
      color: #6b7280;
      font-size: 13px;
      line-height: 1.5;
    }

    .campo {
      margin-bottom: 14px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-size: 13px;
      font-weight: 700;
      color: #374151;
    }

    input,
    select {
      width: 100%;
      min-height: 43px;
      border: 1px solid #d1d5db;
      border-radius: 9px;
      padding: 9px 11px;
      background: white;
      font-size: 14px;
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: #111827;
    }

    .btn {
      min-height: 40px;
      padding: 0 13px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-primary {
      width: 100%;
      min-height: 45px;
      border: none;
      background: #111827;
      color: white;
    }

    .btn-light {
      border: 1px solid #d1d5db;
      background: white;
      color: #374151;
    }

    .btn-danger {
      border: 1px solid #fecaca;
      background: #fef2f2;
      color: #b91c1c;
    }

    .usuarios-list {
      display: grid;
      gap: 14px;
    }

    .user-card {
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 16px;
    }

    .user-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 15px;
      margin-bottom: 15px;
    }

    .user-header h4 {
      margin: 0;
      font-size: 16px;
    }

    .user-header p {
      margin: 5px 0 0;
      color: #6b7280;
      font-size: 12px;
    }

    .badges {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .badge {
      display: inline-block;
      padding: 5px 8px;
      border-radius: 7px;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .badge-owner {
      background: #eef2ff;
      color: #4338ca;
    }

    .badge-employee {
      background: #eff8ff;
      color: #175cd3;
    }

    .badge-active {
      background: #ecfdf3;
      color: #067647;
    }

    .badge-off {
      background: #f3f4f6;
      color: #6b7280;
    }

    .edit-grid {
      display: grid;
      grid-template-columns:
        1fr
        1fr
        170px
        auto;
      gap: 9px;
      align-items: end;
    }

    .password-row {
      display: grid;
      grid-template-columns:
        1fr
        auto;
      gap: 9px;
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid #f0f1f3;
      align-items: end;
    }

    .estado-form {
      margin-top: 10px;
    }

    .owner-note {
      margin-top: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      background: #f9fafb;
      color: #6b7280;
      font-size: 12px;
    }

    @media(max-width:1050px) {

      .grid {
        grid-template-columns: 1fr;
      }

      .edit-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }

    @media(max-width:760px) {

      .sidebar {
        display: none;
      }

      .content {
        padding: 18px;
      }

      .topbar {
        padding: 14px 18px;
      }

      .edit-grid,
      .password-row {
        grid-template-columns: 1fr;
      }

      .user-header {
        flex-direction: column;
      }

      .badges {
        justify-content: flex-start;
      }

    }

  </style>

</head>

<body>

<header class="topbar">

  <div class="brand">

    <h1>
      LA TORRE
    </h1>

    <span>
      Sistema Multisucursal
    </span>

  </div>

  <div class="usuario-top">

    <div class="usuario-info">

      <strong>
        <%= usuario.nombre %>
      </strong>

      <span>
        Dueño · Todas las ubicaciones
      </span>

    </div>

    <form
      action="/logout"
      method="POST"
    >

      <button
        class="logout"
        type="submit"
      >
        Salir
      </button>

    </form>

  </div>

</header>

<div class="layout">

  <aside class="sidebar">

    <a href="/dashboard">
      Inicio
    </a>

    <a href="/caja">
      Caja
    </a>

    <a href="/ventas">
      Ventas
    </a>

    <a href="/presupuestos">
      Presupuestos
    </a>

    <div class="separator"></div>

    <a href="/productos">
      Productos
    </a>

    <a href="/stock">
      Stock
    </a>

    <a href="/transferencias">
      Transferencias
    </a>

    <a href="/ingresos">
      Ingreso de mercadería
    </a>

    <div class="separator"></div>

    <a href="/reportes">
      Reportes
    </a>

    <a href="/movimientos">
      Historial
    </a>

    <a href="/tarjetas">
      Tarjetas y cuotas
    </a>

    <a href="/importacion">
      Importación inicial
    </a>

    <a
      href="/usuarios"
      class="active"
    >
      Usuarios
    </a>

  </aside>

  <main class="content">

    <div class="page-header">

      <h2>
        Usuarios
      </h2>

      <p>
        Accesos del dueño y empleados de cada sucursal.
      </p>

    </div>

    <% if (mensaje) { %>

      <div class="alert alert-ok">
        <%= mensaje %>
      </div>

    <% } %>

    <% if (error) { %>

      <div class="alert alert-error">
        <%= error %>
      </div>

    <% } %>

    <div class="grid">

      <!-- =============================================
           NUEVO EMPLEADO
      ============================================== -->

      <section class="card">

        <h3>
          Nuevo empleado
        </h3>

        <p class="card-description">
          Creá un acceso y asignalo directamente
          a Florida o Delfín Gallo.
        </p>

        <form
          action="/usuarios"
          method="POST"
        >

          <div class="campo">

            <label>
              Nombre
            </label>

            <input
              type="text"
              name="nombre"
              placeholder="Ej: Juan Pérez"
              required
            >

          </div>

          <div class="campo">

            <label>
              Usuario
            </label>

            <input
              type="text"
              name="usuario"
              placeholder="Ej: juan"
              autocomplete="off"
              required
            >

          </div>

          <div class="campo">

            <label>
              Contraseña inicial
            </label>

            <input
              type="password"
              name="password"
              minlength="6"
              autocomplete="new-password"
              required
            >

          </div>

          <div class="campo">

            <label>
              Sucursal
            </label>

            <select
              name="ubicacion_id"
              required
            >

              <option value="">
                Seleccionar...
              </option>

              <% ubicaciones.forEach(
                ubicacion => {
              %>

                <option
                  value="<%= ubicacion.id %>"
                >
                  <%= ubicacion.nombre %>
                </option>

              <% }) %>

            </select>

          </div>

          <button
            class="btn btn-primary"
            type="submit"
          >
            Crear empleado
          </button>

        </form>

      </section>

      <!-- =============================================
           USUARIOS EXISTENTES
      ============================================== -->

      <section class="card">

        <h3>
          Usuarios del sistema
        </h3>

        <p class="card-description">
          Modificá nombres, accesos, sucursales y contraseñas.
        </p>

        <div class="usuarios-list">

          <% usuarios.forEach(
            item => {
          %>

            <div class="user-card">

              <div class="user-header">

                <div>

                  <h4>
                    <%= item.nombre %>
                  </h4>

                  <p>
                    Usuario:
                    <strong>
                      <%= item.usuario %>
                    </strong>

                    <% if (item.ubicacion) { %>

                      · <%= item.ubicacion %>

                    <% } %>

                  </p>

                </div>

                <div class="badges">

                  <% if (
                    item.rol === "dueno"
                  ) { %>

                    <span class="badge badge-owner">
                      Dueño
                    </span>

                  <% } else { %>

                    <span class="badge badge-employee">
                      Empleado
                    </span>

                  <% } %>

                  <% if (
                    item.activo
                  ) { %>

                    <span class="badge badge-active">
                      Activo
                    </span>

                  <% } else { %>

                    <span class="badge badge-off">
                      Inactivo
                    </span>

                  <% } %>

                </div>

              </div>

              <form
                action="/usuarios/<%= item.id %>/editar"
                method="POST"
              >

                <div class="edit-grid">

                  <div>

                    <label>
                      Nombre
                    </label>

                    <input
                      type="text"
                      name="nombre"
                      value="<%= item.nombre %>"
                      required
                    >

                  </div>

                  <div>

                    <label>
                      Usuario
                    </label>

                    <input
                      type="text"
                      name="usuario"
                      value="<%= item.usuario %>"
                      required
                    >

                  </div>

                  <div>

                    <label>
                      Sucursal
                    </label>

                    <% if (
                      item.rol === "empleado"
                    ) { %>

                      <select
                        name="ubicacion_id"
                        required
                      >

                        <% ubicaciones.forEach(
                          ubicacion => {
                        %>

                          <option
                            value="<%= ubicacion.id %>"
                            <%= Number(item.ubicacion_id) === Number(ubicacion.id) ? "selected" : "" %>
                          >
                            <%= ubicacion.nombre %>
                          </option>

                        <% }) %>

                      </select>

                    <% } else { %>

                      <input
                        type="text"
                        value="Todas"
                        disabled
                      >

                    <% } %>

                  </div>

                  <button
                    class="btn btn-light"
                    type="submit"
                  >
                    Guardar
                  </button>

                </div>

              </form>

              <form
                action="/usuarios/<%= item.id %>/password"
                method="POST"
              >

                <div class="password-row">

                  <div>

                    <label>
                      Nueva contraseña
                    </label>

                    <input
                      type="password"
                      name="password"
                      minlength="6"
                      placeholder="Mínimo 6 caracteres"
                      autocomplete="new-password"
                      required
                    >

                  </div>

                  <button
                    class="btn btn-light"
                    type="submit"
                  >
                    Cambiar contraseña
                  </button>

                </div>

              </form>

              <% if (
                item.rol === "empleado"
              ) { %>

                <form
                  class="estado-form"
                  action="/usuarios/<%= item.id %>/estado"
                  method="POST"
                  onsubmit="return confirmarEstado('<%= item.nombre.replace(/'/g, "\\'") %>', <%= item.activo ? 'true' : 'false' %>);"
                >

                  <button
                    class="btn <%= item.activo ? 'btn-danger' : 'btn-light' %>"
                    type="submit"
                  >

                    <% if (item.activo) { %>
                      Desactivar acceso
                    <% } else { %>
                      Activar acceso
                    <% } %>

                  </button>

                </form>

              <% } else { %>

                <div class="owner-note">

                  El usuario dueño tiene acceso general
                  y no puede ser desactivado desde esta pantalla.

                </div>

              <% } %>

            </div>

          <% }) %>

        </div>

      </section>

    </div>

  </main>

</div>

<script>

  function confirmarEstado(
    nombre,
    activo
  ) {

    if (activo) {
      return confirm(
        `¿Desactivar el acceso de ${nombre}?`
      );
    }

    return confirm(
      `¿Volver a activar el acceso de ${nombre}?`
    );

  }

</script>

</body>

</html>