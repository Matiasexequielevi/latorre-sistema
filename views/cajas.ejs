<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>La Torre | Cajas</title><link rel="stylesheet" href="/css/style.css"><style>body{background:#f3f4f6;font-family:Segoe UI,Arial;margin:0;color:#111827}.wrap{max-width:1100px;margin:30px auto;padding:0 20px}.top{display:flex;justify-content:space-between;align-items:center}.card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:22px;margin:16px 0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.k{background:#f9fafb;padding:14px;border-radius:10px}.k span{color:#6b7280;font-size:12px;display:block}.k strong{font-size:20px}.btn{background:#111827;color:#fff;border:0;border-radius:9px;padding:11px 16px;font-weight:700;cursor:pointer;text-decoration:none}.inp{width:100%;padding:11px;border:1px solid #d1d5db;border-radius:9px;margin:6px 0 12px}.alert{padding:12px;border-radius:9px;margin:12px 0}.ok{background:#ecfdf3}.err{background:#fef2f2}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:10px;border-bottom:1px solid #eee;text-align:left}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style></head><body><div class="wrap"><div class="top"><div><h1>Control de caja</h1><p>Apertura, cierre y arqueo por empleado.</p></div><a class="btn" href="/dashboard">Volver</a></div><% if(mensaje){%><div class="alert ok"><%=mensaje%></div><%}%><% if(error){%><div class="alert err"><%=error%></div><%}%>
<% if(!abierta){%><section class="card"><h2>Abrir caja</h2><form method="post" action="/cajas/abrir"><% if(usuario.rol==='dueno'){%><label>Local</label><select class="inp" name="ubicacion_id" required><option value="">Seleccionar...</option><% locales.forEach(l=>{%><option value="<%=l.id%>"><%=l.nombre%></option><%})%></select><%}%><label>Efectivo inicial</label><input class="inp" name="monto_inicial" type="number" min="0" step="0.01" value="0" required><label>Observación</label><input class="inp" name="observaciones" placeholder="Opcional"><button class="btn">Abrir caja</button></form></section><%}else{%><section class="card"><h2>Caja abierta</h2><div class="grid"><div class="k"><span>Sucursal</span><strong><%=abierta.ubicacion%></strong></div><div class="k"><span>Desde</span><strong><%=new Date(abierta.apertura_at).toLocaleString('es-AR')%></strong></div><div class="k"><span>Fondo inicial</span><strong>$<%=Number(abierta.monto_inicial).toLocaleString('es-AR')%></strong></div></div><h3>Ventas por medio de pago</h3><div class="grid"><% resumen.forEach(r=>{%><div class="k"><span><%=r.nombre%> · <%=r.cantidad%> ventas</span><strong>$<%=Number(r.total).toLocaleString('es-AR')%></strong></div><%})%></div><form method="post" action="/cajas/<%=abierta.id%>/cerrar"><h3>Cierre / arqueo</h3><label>Efectivo contado</label><input class="inp" name="efectivo_contado" type="number" min="0" step="0.01" required><label>Observación</label><input class="inp" name="observaciones" placeholder="Opcional"><button class="btn">Cerrar caja</button></form></section><%}%>
<section class="card"><h2>Historial</h2><table class="table"><thead><tr><th>Apertura</th><th>Usuario</th><th>Sucursal</th><th>Ventas</th><th>Estado</th><th>Diferencia</th></tr></thead><tbody><% cajas.forEach(c=>{%><tr><td><%=new Date(c.apertura_at).toLocaleString('es-AR')%></td><td><%=c.usuario_nombre%></td><td><%=c.ubicacion%></td><td>$<%=Number(c.total_ventas).toLocaleString('es-AR')%></td><td><%=c.estado%></td><td><%=c.diferencia==null?'-':'$'+Number(c.diferencia).toLocaleString('es-AR')%></td></tr><%})%></tbody></table></section></div></body></html>
