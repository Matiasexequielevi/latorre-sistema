<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>La Torre | Punto de Venta</title>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --dark: #111827;
      --dark2: #1f2937;
      --text: #111827;
      --muted: #6b7280;
      --border: #e5e7eb;
      --background: #f3f4f6;
      --green: #059669;
      --green-dark: #047857;
      --green-bg: #ecfdf5;
      --green-border: #a7f3d0;
      --orange: #d97706;
      --orange-bg: #fff7ed;
      --orange-border: #fed7aa;
      --red: #b91c1c;
    }

    body {
      margin: 0;
      background: var(--background);
      color: var(--text);
      font-family: "Segoe UI", Arial, sans-serif;
    }

    /* =====================================================
       TOPBAR
    ===================================================== */

    .topbar {
      min-height: 72px;
      background: var(--dark);
      color: white;
      padding: 0 26px;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand h1 {
      margin: 0;
      font-size: 24px;
      letter-spacing: .3px;
    }

    .brand span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .usuario {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .usuario-info {
      text-align: right;
    }

    .usuario-info strong {
      display: block;
      font-size: 14px;
    }

    .usuario-info span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .logout {
      border: 1px solid #374151;
      border-radius: 9px;
      padding: 9px 12px;
      background: var(--dark2);
      color: white;
      cursor: pointer;
      font-weight: 600;
    }

    /* =====================================================
       LAYOUT
    ===================================================== */

    .layout {
      display: flex;
      min-height: calc(100vh - 72px);
    }

    .sidebar {
      width: 235px;
      flex-shrink: 0;
      background: white;
      border-right: 1px solid var(--border);
      padding: 20px 14px;
    }

    .sidebar a {
      display: block;
      margin-bottom: 5px;
      padding: 12px 14px;
      border-radius: 9px;
      text-decoration: none;
      color: #374151;
      font-size: 14px;
      font-weight: 600;
      transition: .15s;
    }

    .sidebar a:hover {
      background: #f3f4f6;
    }

    .sidebar a.active {
      background: var(--dark);
      color: white;
    }

    .separator {
      height: 1px;
      margin: 14px 8px;
      background: var(--border);
    }

    .content {
      flex: 1;
      min-width: 0;
      padding: 25px;
    }

    /* =====================================================
       HEADER
    ===================================================== */

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 18px;
    }

    .page-header h2 {
      margin: 0;
      font-size: 28px;
    }

    .page-header p {
      margin: 7px 0 0;
      color: var(--muted);
    }

    .sucursal-badge {
      padding: 10px 14px;
      border-radius: 10px;
      background: var(--dark);
      color: white;
      font-size: 13px;
      font-weight: 700;
    }

    /* =====================================================
       ESTADO DE CAJA
    ===================================================== */

    .estado-caja {
      margin-bottom: 18px;
      border-radius: 14px;
      padding: 15px 18px;

      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .estado-caja.activa {
      background: var(--green-bg);
      border: 1px solid var(--green-border);
    }

    .estado-caja.inactiva {
      background: var(--orange-bg);
      border: 1px solid var(--orange-border);
    }

    .estado-info {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    .estado-icono {
      width: 40px;
      height: 40px;
      border-radius: 50%;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 17px;
      font-weight: 900;
    }

    .activa .estado-icono {
      background: #d1fae5;
      color: var(--green-dark);
    }

    .inactiva .estado-icono {
      background: #ffedd5;
      color: var(--orange);
    }

    .estado-texto strong {
      display: block;
      font-size: 14px;
    }

    .estado-texto span {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: 12px;
    }

    .btn-resumen {
      display: inline-block;
      padding: 10px 15px;
      border-radius: 9px;
      background: var(--dark);
      color: white;
      text-decoration: none;
      font-size: 13px;
      font-weight: 700;
    }

    .btn-resumen:hover {
      background: var(--dark2);
    }

    .inactiva .btn-resumen {
      background: var(--green);
    }

    .inactiva .btn-resumen:hover {
      background: var(--green-dark);
    }

    /* =====================================================
       ALERTAS
    ===================================================== */

    .alert {
      margin-bottom: 18px;
      padding: 13px 16px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
    }

    .alert-ok {
      background: #ecfdf3;
      color: #067647;
      border: 1px solid #abefc6;
    }

    .alert-error {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }

    /* =====================================================
       CAJA GRID
    ===================================================== */

    .caja-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 390px;
      gap: 18px;
      align-items: start;
    }

    .card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 19px;
    }

    .card-title {
      margin: 0 0 15px;
      font-size: 17px;
      font-weight: 800;
    }

    .section-title {
      margin: 0 0 5px;
      font-size: 16px;
      font-weight: 800;
    }

    .section-help {
      margin: 0 0 15px;
      color: var(--muted);
      font-size: 12px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      color: #374151;
      font-size: 13px;
      font-weight: 700;
    }

    input,
    select {
      width: 100%;
      min-height: 44px;
      padding: 9px 12px;
      border: 1px solid #d1d5db;
      border-radius: 9px;
      background: white;
      font-size: 14px;
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: var(--dark);
      box-shadow: 0 0 0 3px rgba(17, 24, 39, .06);
    }

    /* =====================================================
       BUSCADOR
    ===================================================== */

    .search-area {
      position: relative;
      margin-bottom: 17px;
    }

    .search-input {
      height: 54px;
      padding: 0 16px;
      font-size: 16px;
      border: 2px solid var(--dark);
    }

    .search-help {
      margin-top: 6px;
      color: #9ca3af;
      font-size: 11px;
    }

    .resultados {
      position: absolute;
      left: 0;
      right: 0;
      top: 83px;
      z-index: 100;

      max-height: 330px;
      overflow-y: auto;

      background: white;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      box-shadow: 0 18px 45px rgba(0, 0, 0, .15);

      display: none;
    }

    .resultado {
      padding: 12px 14px;
      cursor: pointer;
      border-bottom: 1px solid #f0f1f3;
    }

    .resultado:hover {
      background: #f9fafb;
    }

    .resultado strong {
      display: block;
    }

    .resultado span {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: 12px;
    }

    .sin-stock {
      color: var(--red) !important;
    }

    /* =====================================================
       TABLA
    ===================================================== */

    .table-card {
      border: 1px solid var(--border);
      border-radius: 11px;
      overflow-x: auto;
    }

    table {
      width: 100%;
      min-width: 720px;
      border-collapse: collapse;
    }

    th {
      padding: 12px;
      background: #f9fafb;
      color: var(--muted);
      border-bottom: 1px solid var(--border);
      text-align: left;
      font-size: 11px;
      text-transform: uppercase;
    }

    td {
      padding: 12px;
      border-bottom: 1px solid #f1f2f4;
      font-size: 13px;
      vertical-align: middle;
    }

    .producto-nombre {
      font-weight: 700;
    }

    .producto-codigo {
      margin-top: 3px;
      color: #9ca3af;
      font-size: 11px;
    }

    .cantidad {
      width: 80px;
    }

    .precio {
      font-weight: 700;
      white-space: nowrap;
    }

    .precio-item {
      width: 125px;
      font-weight: 700;
    }

    .btn-quitar {
      border: 1px solid #fecaca;
      background: #fef2f2;
      color: var(--red);
      border-radius: 7px;
      padding: 7px 9px;
      font-weight: 700;
      cursor: pointer;
    }

    .empty {
      padding: 42px;
      text-align: center;
      color: #9ca3af;
    }

    /* =====================================================
       CLIENTE
    ===================================================== */

    .cliente-box {
      margin-top: 18px;
      padding-top: 17px;
      border-top: 1px solid var(--border);
    }

    .cliente-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    /* =====================================================
       RESUMEN
    ===================================================== */

    .sidebar-caja {
      position: sticky;
      top: 20px;
      height: fit-content;
    }

    .resumen-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin: 11px 0;
      font-size: 14px;
    }

    .resumen-row span {
      color: var(--muted);
    }

    .resumen-row strong {
      font-size: 15px;
    }

    .campo {
      margin-top: 15px;
    }

    .tarjeta-box {
      display: none;
    }

    .flete-check {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 11px 12px;
      background: #f9fafb;
      border: 1px solid var(--border);
      border-radius: 9px;
      cursor: pointer;
    }

    .flete-check input {
      width: auto;
      min-height: auto;
      margin: 0;
    }

    .flete-check label {
      margin: 0;
      cursor: pointer;
    }

    .total-box {
      margin-top: 18px;
      padding-top: 17px;
      border-top: 2px solid var(--dark);
    }

    .total-label {
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .4px;
    }

    .total {
      margin-top: 5px;
      font-size: 36px;
      font-weight: 900;
      letter-spacing: -1px;
    }

    .cuota-final {
      margin-top: 6px;
      color: var(--muted);
      font-size: 13px;
      display: none;
    }

    .btn-vender {
      width: 100%;
      min-height: 54px;
      margin-top: 20px;
      border: none;
      border-radius: 10px;
      background: var(--green);
      color: white;
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
    }

    .btn-vender:hover {
      background: var(--green-dark);
    }

    .btn-vender:disabled {
      opacity: .55;
      cursor: not-allowed;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 1100px) {
      .caja-grid {
        grid-template-columns: 1fr;
      }

      .sidebar-caja {
        position: static;
      }
    }

    @media (max-width: 760px) {
      .sidebar {
        display: none;
      }

      .content {
        padding: 16px;
      }

      .topbar {
        padding: 14px 18px;
      }

      .cliente-grid {
        grid-template-columns: 1fr;
      }

      .page-header {
        flex-direction: column;
      }
    }
  </style>
</head>

<body>

<header class="topbar">

  <div class="brand">
    <h1>LA TORRE</h1>
    <span>Sistema Multisucursal</span>
  </div>

  <div class="usuario">

    <div class="usuario-info">
      <strong><%= usuario.nombre %></strong>

      <span>
        <% if (usuario.rol === "dueno") { %>
          Dueño
        <% } else { %>
          <%= usuario.ubicacion %>
        <% } %>
      </span>
    </div>

    <form action="/logout" method="POST">
      <button type="submit" class="logout">
        Salir
      </button>
    </form>

  </div>

</header>

<div class="layout">

  <!-- =====================================================
       MENÚ
  ====================================================== -->

  <aside class="sidebar">

    <a href="/dashboard">
      Inicio
    </a>

    <a href="/caja" class="active">
      Punto de Venta
    </a>

    <a href="/ventas">
      Ventas
    </a>

    <a href="/presupuestos">
      Presupuestos
    </a>

    <div class="separator"></div>

    <a href="/productos">
      Productos
    </a>

    <a href="/stock">
      Stock
    </a>

    <a href="/transferencias">
      Transferencias
    </a>

    <a href="/ingresos">
      Ingreso de mercadería
    </a>

    <div class="separator"></div>

    <a href="/reportes">
      Reportes
    </a>

    <a href="/movimientos">
      Historial
    </a>

  </aside>

  <!-- =====================================================
       CONTENIDO
  ====================================================== -->

  <main class="content">

    <div class="page-header">

      <div>
        <h2>Punto de Venta</h2>

        <p>
          Escaneá, buscá productos y registrá la venta.
        </p>
      </div>

      <% if (usuario.rol === "empleado") { %>

        <div class="sucursal-badge">
          <%= usuario.ubicacion %>
        </div>

      <% } %>

    </div>

    <!-- ===================================================
         ESTADO DEL TURNO / CAJA
    ==================================================== -->

    <% if (cajaAbierta) { %>

      <div class="estado-caja activa">

        <div class="estado-info">

          <div class="estado-icono">
            ✓
          </div>

          <div class="estado-texto">

            <strong>
              Caja activa
            </strong>

            <span>
              <%= cajaAbierta.ubicacion %>
              · Apertura:
              <%= new Date(cajaAbierta.apertura_at).toLocaleTimeString(
                'es-AR',
                {
                  hour: '2-digit',
                  minute: '2-digit'
                }
              ) %>
              · Fondo inicial:
              $<%= Number(cajaAbierta.monto_inicial || 0).toLocaleString(
                'es-AR',
                {
                  minimumFractionDigits: 2,
                  maximumFractionDigits: 2
                }
              ) %>
            </span>

          </div>

        </div>

        <a href="/cajas" class="btn-resumen">
          Ver resumen de caja
        </a>

      </div>

    <% } else if (usuario.rol === "empleado") { %>

      <div class="estado-caja inactiva">

        <div class="estado-info">

          <div class="estado-icono">
            !
          </div>

          <div class="estado-texto">

            <strong>
              Turno sin iniciar
            </strong>

            <span>
              Abrí tu caja antes de comenzar a registrar ventas.
            </span>

          </div>

        </div>

        <a href="/cajas" class="btn-resumen">
          Iniciar turno
        </a>

      </div>

    <% } else { %>

      <div class="estado-caja activa">

        <div class="estado-info">

          <div class="estado-icono">
            ✓
          </div>

          <div class="estado-texto">

            <strong>
              Modo administrador
            </strong>

            <span>
              Seleccioná el local donde vas a registrar la venta.
            </span>

          </div>

        </div>

        <a href="/cajas" class="btn-resumen">
          Resumen de cajas
        </a>

      </div>

    <% } %>

    <!-- ===================================================
         MENSAJES
    ==================================================== -->

    <% if (mensaje) { %>

      <div class="alert alert-ok">
        <%= mensaje %>
      </div>

    <% } %>

    <% if (error) { %>

      <div class="alert alert-error">
        <%= error %>
      </div>

    <% } %>

    <!-- ===================================================
         FORMULARIO DE VENTA
    ==================================================== -->

    <form
      id="formVenta"
      action="/caja/venta"
      method="POST"
    >

      <div class="caja-grid">

        <!-- =================================================
             IZQUIERDA
        ================================================== -->

        <div>

          <% if (usuario.rol === "dueno") { %>

            <section
              class="card"
              style="margin-bottom:18px;"
            >

              <label>
                Local donde se realiza la venta
              </label>

              <select
                id="ubicacion"
                name="ubicacion_id"
                required
              >

                <option value="">
                  Seleccionar local...
                </option>

                <% ubicaciones.forEach(ubicacion => { %>

                  <option value="<%= ubicacion.id %>">
                    <%= ubicacion.nombre %>
                  </option>

                <% }) %>

              </select>

            </section>

          <% } else { %>

            <input
              id="ubicacion"
              type="hidden"
              value="<%= usuario.ubicacion_id %>"
            >

          <% } %>

          <!-- ===============================================
               PRODUCTOS
          ================================================ -->

          <section class="card">

            <h3 class="section-title">
              Productos
            </h3>

            <p class="section-help">
              Usá el lector de código de barras o buscá por nombre, código o marca.
            </p>

            <div class="search-area">

              <input
                id="buscarProducto"
                class="search-input"
                type="text"
                autocomplete="off"
                placeholder="Escanear código o buscar producto..."
                autofocus
              >

              <div class="search-help">
                Con el lector podés escanear directamente y presionar Enter.
              </div>

              <div
                id="resultados"
                class="resultados"
              ></div>

            </div>

            <div class="table-card">

              <table>

                <thead>

                  <tr>
                    <th>Producto</th>
                    <th>Stock</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Subtotal</th>
                    <th></th>
                  </tr>

                </thead>

                <tbody id="detalle">

                  <tr>

                    <td
                      colspan="6"
                      class="empty"
                    >
                      Escaneá o buscá un producto para comenzar.
                    </td>

                  </tr>

                </tbody>

              </table>

            </div>

            <!-- =============================================
                 CLIENTE
            ============================================== -->

            <div class="cliente-box">

              <h3 class="section-title">
                Datos del cliente
              </h3>

              <p class="section-help">
                Opcional. Podés dejar estos campos vacíos.
              </p>

              <div class="cliente-grid">

                <div>

                  <label>
                    Cliente
                  </label>

                  <input
                    type="text"
                    name="cliente_nombre"
                    placeholder="Nombre y apellido"
                  >

                </div>

                <div>

                  <label>
                    DNI / CUIT
                  </label>

                  <input
                    type="text"
                    name="cliente_documento"
                    placeholder="Opcional"
                  >

                </div>

                <div>

                  <label>
                    Teléfono
                  </label>

                  <input
                    type="text"
                    name="cliente_telefono"
                    placeholder="Opcional"
                  >

                </div>

              </div>

            </div>

          </section>

        </div>

        <!-- =================================================
             DERECHA
        ================================================== -->

        <aside class="card sidebar-caja">

          <h3 class="card-title">
            Resumen de venta
          </h3>

          <div class="resumen-row">

            <span>
              Artículos
            </span>

            <strong id="cantidadArticulos">
              0
            </strong>

          </div>

          <div class="resumen-row">

            <span>
              Subtotal
            </span>

            <strong id="subtotalVista">
              $0,00
            </strong>

          </div>

          <!-- ===============================================
               FORMA DE PAGO
          ================================================ -->

          <div class="campo">

            <label>
              Forma de pago
            </label>

            <select
              name="forma_pago_id"
              id="formaPago"
              required
            >

              <option
                value=""
                data-tipo=""
              >
                Seleccionar...
              </option>

              <% formasPago.forEach(forma => { %>

                <option
                  value="<%= forma.id %>"
                  data-tipo="<%= forma.tipo %>"
                >
                  <%= forma.nombre %>
                </option>

              <% }) %>

            </select>

          </div>

          <!-- ===============================================
               TARJETA
          ================================================ -->

          <div
            id="tarjetaBox"
            class="tarjeta-box"
          >

            <div class="campo">

              <label>
                Tarjeta
              </label>

              <select
                name="tarjeta_id"
                id="tarjeta"
              >

                <option value="">
                  Seleccionar tarjeta...
                </option>

                <% tarjetas.forEach(tarjeta => { %>

                  <option value="<%= tarjeta.id %>">
                    <%= tarjeta.nombre %>
                  </option>

                <% }) %>

              </select>

            </div>

            <div class="campo">

              <label>
                Cuotas
              </label>

              <select
                name="cuotas"
                id="cuotas"
              >

                <option value="">
                  Seleccionar...
                </option>

              </select>

            </div>

          </div>

          <!-- ===============================================
               FLETE
          ================================================ -->

          <div class="campo">

            <div class="flete-check">

              <input
                type="checkbox"
                id="incluirFlete"
                name="incluir_flete"
                value="1"
              >

              <label for="incluirFlete">
                Agregar flete
              </label>

            </div>

          </div>

          <div
            class="campo"
            id="fleteBox"
            style="display:none;"
          >

            <label>
              Costo de flete
            </label>

            <input
              type="number"
              id="flete"
              name="flete"
              min="0"
              step="0.01"
              value="0"
            >

            <div class="search-help">
              Se suma al total de la operación.
            </div>

          </div>

          <!-- ===============================================
               DESCUENTO
          ================================================ -->

          <div class="campo">

            <label>
              Descuento %
            </label>

            <input
              type="number"
              name="descuento_porcentaje"
              id="descuento"
              min="0"
              max="100"
              step="0.01"
              value="0"
            >

          </div>

          <div class="resumen-row">

            <span>
              Descuento
            </span>

            <strong id="descuentoVista">
              $0,00
            </strong>

          </div>

          <div class="resumen-row">

            <span>
              Recargo
            </span>

            <strong id="recargoVista">
              $0,00
            </strong>

          </div>

          <!-- ===============================================
               TOTAL
          ================================================ -->

          <div class="total-box">

            <div class="total-label">
              TOTAL
            </div>

            <div
              class="total"
              id="totalVista"
            >
              $0,00
            </div>

            <div
              class="cuota-final"
              id="cuotaVista"
            ></div>

          </div>

          <input
            type="hidden"
            name="items"
            id="itemsJson"
          >

          <button
            class="btn-vender"
            type="submit"
          >
            Finalizar venta
          </button>

        </aside>

      </div>

    </form>

  </main>

</div>

<script>
  let carrito = [];
  let timerBusqueda = null;
  let recargoPorcentaje = 0;

  const buscar =
    document.getElementById("buscarProducto");

  const resultados =
    document.getElementById("resultados");

  const detalle =
    document.getElementById("detalle");

  const ubicacion =
    document.getElementById("ubicacion");

  const formaPago =
    document.getElementById("formaPago");

  const tarjeta =
    document.getElementById("tarjeta");

  const cuotas =
    document.getElementById("cuotas");

  const tarjetaBox =
    document.getElementById("tarjetaBox");

  const descuento =
    document.getElementById("descuento");

  const itemsJson =
    document.getElementById("itemsJson");

  const incluirFlete =
    document.getElementById("incluirFlete");

  const flete =
    document.getElementById("flete");

  const fleteBox =
    document.getElementById("fleteBox");

  // =====================================================
  // DINERO
  // =====================================================

  function dinero(valor) {
    return Number(valor || 0).toLocaleString(
      "es-AR",
      {
        style: "currency",
        currency: "ARS",
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }
    );
  }

  // =====================================================
  // TIPO DE PAGO
  // =====================================================

  function tipoPagoActual() {
    const option =
      formaPago.options[
        formaPago.selectedIndex
      ];

    return option
      ? option.dataset.tipo
      : "";
  }

  // =====================================================
  // CAMBIO DE SUCURSAL - DUEÑO
  // =====================================================

  <% if (usuario.rol === "dueno") { %>

    ubicacion.addEventListener(
      "change",
      () => {
        carrito = [];

        renderCarrito();

        buscar.value = "";

        resultados.style.display =
          "none";

        buscar.focus();
      }
    );

  <% } %>

  // =====================================================
  // BUSCAR PRODUCTO
  // =====================================================

  buscar.addEventListener(
    "input",
    () => {
      clearTimeout(timerBusqueda);

      timerBusqueda =
        setTimeout(
          () => buscarProductos(false),
          220
        );
    }
  );

  buscar.addEventListener(
    "keydown",
    event => {
      if (event.key === "Enter") {
        event.preventDefault();

        buscarProductos(true);
      }
    }
  );

  async function buscarProductos(automatico) {
    const texto =
      buscar.value.trim();

    const ubicacionId =
      ubicacion.value;

    if (!ubicacionId) {
      resultados.innerHTML =
        `
          <div class="resultado">
            Primero seleccioná el local.
          </div>
        `;

      resultados.style.display =
        "block";

      return;
    }

    if (!texto) {
      resultados.style.display =
        "none";

      return;
    }

    try {
      const response =
        await fetch(
          `/caja/api/productos?buscar=${encodeURIComponent(texto)}&ubicacion_id=${encodeURIComponent(ubicacionId)}`
        );

      const productos =
        await response.json();

      if (productos.length === 0) {
        resultados.innerHTML =
          `
            <div class="resultado">
              Producto no encontrado.
            </div>
          `;

        resultados.style.display =
          "block";

        return;
      }

      // ESCÁNER
      if (automatico) {
        const exacto =
          productos.find(
            producto =>
              producto.codigo_barras === texto ||
              producto.codigo_interno === texto
          );

        if (exacto) {
          agregarProducto(exacto);
          return;
        }

        if (productos.length === 1) {
          agregarProducto(productos[0]);
          return;
        }
      }

      resultados.innerHTML = "";

      productos.forEach(
        producto => {
          const div =
            document.createElement("div");

          div.className =
            "resultado";

          div.innerHTML =
            `
              <strong>
                ${producto.descripcion}
              </strong>

              <span class="${producto.stock <= 0 ? "sin-stock" : ""}">
                ${producto.codigo_interno || "-"}
                ·
                ${producto.marca || "Sin marca"}
                ·
                Stock: ${producto.stock}
                ·
                ${dinero(producto.precio_efectivo)}
              </span>
            `;

          div.addEventListener(
            "click",
            () => agregarProducto(producto)
          );

          resultados.appendChild(div);
        }
      );

      resultados.style.display =
        "block";

    } catch (error) {
      console.error(error);
    }
  }

  // =====================================================
  // AGREGAR PRODUCTO
  // =====================================================

  function agregarProducto(producto) {
    if (Number(producto.stock) <= 0) {
      alert(
        "Este producto no tiene stock en este local."
      );

      return;
    }

    const existente =
      carrito.find(
        item =>
          item.producto_id === producto.id
      );

    if (existente) {
      if (
        existente.cantidad + 1 >
        existente.stock
      ) {
        alert(
          "No hay más stock disponible."
        );

        return;
      }

      existente.cantidad += 1;

    } else {
      carrito.push({
        producto_id: producto.id,
        descripcion: producto.descripcion,
        codigo_interno: producto.codigo_interno,

        stock:
          Number(producto.stock),

        precio_efectivo:
          Number(producto.precio_efectivo),

        precio_tarjeta:
          Number(producto.precio_tarjeta),

        cantidad: 1,

        precio_manual: null
      });
    }

    buscar.value = "";

    resultados.style.display =
      "none";

    renderCarrito();

    buscar.focus();
  }

  // =====================================================
  // PRECIO DEL ITEM
  // =====================================================

  function obtenerPrecio(item) {
    if (
      item.precio_manual !== null &&
      Number.isFinite(
        Number(item.precio_manual)
      )
    ) {
      return Number(item.precio_manual);
    }

    if (
      tipoPagoActual() === "tarjeta" &&
      item.precio_tarjeta > 0
    ) {
      return item.precio_tarjeta;
    }

    return item.precio_efectivo;
  }

  // =====================================================
  // RENDER DEL CARRITO
  // =====================================================

  function renderCarrito() {
    detalle.innerHTML = "";

    if (carrito.length === 0) {
      detalle.innerHTML =
        `
          <tr>
            <td colspan="6" class="empty">
              Escaneá o buscá un producto para comenzar.
            </td>
          </tr>
        `;

      actualizarTotales();

      return;
    }

    carrito.forEach(
      (item, index) => {
        const precio =
          obtenerPrecio(item);

        const subtotal =
          precio * item.cantidad;

        const tr =
          document.createElement("tr");

        tr.innerHTML =
          `
            <td>

              <div class="producto-nombre">
                ${item.descripcion}
              </div>

              <div class="producto-codigo">
                ${item.codigo_interno || "-"}
              </div>

            </td>

            <td>
              ${item.stock}
            </td>

            <td>

              <input
                class="cantidad"
                type="number"
                min="0.001"
                max="${item.stock}"
                step="0.001"
                value="${item.cantidad}"
                data-index="${index}"
              >

            </td>

            <td class="precio">

              <input
                class="precio-item"
                type="number"
                min="0"
                step="0.01"
                value="${precio}"
                data-precio-index="${index}"
              >

            </td>

            <td class="precio">
              ${dinero(subtotal)}
            </td>

            <td>

              <button
                type="button"
                class="btn-quitar"
                data-remove="${index}"
              >
                Quitar
              </button>

            </td>
          `;

        detalle.appendChild(tr);
      }
    );

    // CANTIDADES
    detalle
      .querySelectorAll(".cantidad")
      .forEach(
        input => {
          input.addEventListener(
            "change",
            () => {
              const index =
                Number(input.dataset.index);

              let cantidad =
                Number(input.value);

              if (
                !Number.isFinite(cantidad) ||
                cantidad <= 0
              ) {
                cantidad = 1;
              }

              if (
                cantidad >
                carrito[index].stock
              ) {
                cantidad =
                  carrito[index].stock;

                alert(
                  "La cantidad supera el stock disponible."
                );
              }

              carrito[index].cantidad =
                cantidad;

              renderCarrito();
            }
          );
        }
      );

    // PRECIO MANUAL
    detalle
      .querySelectorAll(".precio-item")
      .forEach(
        input => {
          const guardar = () => {
            const index =
              Number(
                input.dataset.precioIndex
              );

            const valor =
              Number(input.value);

            if (
              !Number.isFinite(valor) ||
              valor < 0
            ) {
              return;
            }

            carrito[index].precio_manual =
              valor;

            renderCarrito();
          };

          input.addEventListener(
            "change",
            guardar
          );

          input.addEventListener(
            "keydown",
            event => {
              if (event.key === "Enter") {
                event.preventDefault();

                guardar();
              }
            }
          );
        }
      );

    // QUITAR
    detalle
      .querySelectorAll("[data-remove]")
      .forEach(
        boton => {
          boton.addEventListener(
            "click",
            () => {
              carrito.splice(
                Number(
                  boton.dataset.remove
                ),
                1
              );

              renderCarrito();

              buscar.focus();
            }
          );
        }
      );

    actualizarTotales();
  }

  // =====================================================
  // TOTALES
  // =====================================================

  function actualizarTotales() {
    let subtotal = 0;
    let cantidadTotal = 0;

    carrito.forEach(
      item => {
        subtotal +=
          obtenerPrecio(item) *
          item.cantidad;

        cantidadTotal +=
          item.cantidad;
      }
    );

    let descuentoPorcentaje =
      Number(descuento.value) || 0;

    if (descuentoPorcentaje < 0) {
      descuentoPorcentaje = 0;
    }

    if (descuentoPorcentaje > 100) {
      descuentoPorcentaje = 100;
    }

    const descuentoMonto =
      subtotal *
      (descuentoPorcentaje / 100);

    const base =
      subtotal -
      descuentoMonto;

    const recargoMonto =
      base *
      (recargoPorcentaje / 100);

    const fleteMonto =
      incluirFlete &&
      incluirFlete.checked
        ? Number(flete.value) || 0
        : 0;

    const total =
      base +
      recargoMonto +
      fleteMonto;

    document.getElementById(
      "cantidadArticulos"
    ).textContent =
      cantidadTotal;

    document.getElementById(
      "subtotalVista"
    ).textContent =
      dinero(subtotal);

    document.getElementById(
      "descuentoVista"
    ).textContent =
      dinero(descuentoMonto);

    document.getElementById(
      "recargoVista"
    ).textContent =
      dinero(recargoMonto);

    document.getElementById(
      "totalVista"
    ).textContent =
      dinero(total);

    const cuotaVista =
      document.getElementById(
        "cuotaVista"
      );

    const cantidadCuotas =
      Number(cuotas.value);

    if (
      tipoPagoActual() === "tarjeta" &&
      cantidadCuotas > 0
    ) {
      cuotaVista.style.display =
        "block";

      cuotaVista.textContent =
        `${cantidadCuotas} cuotas de ${dinero(
          total / cantidadCuotas
        )}`;
    } else {
      cuotaVista.style.display =
        "none";

      cuotaVista.textContent =
        "";
    }
  }

  // =====================================================
  // FORMA DE PAGO
  // =====================================================

  formaPago.addEventListener(
    "change",
    () => {
      const tipo =
        tipoPagoActual();

      if (tipo === "tarjeta") {
        tarjetaBox.style.display =
          "block";
      } else {
        tarjetaBox.style.display =
          "none";

        tarjeta.value = "";

        cuotas.innerHTML =
          `
            <option value="">
              Seleccionar...
            </option>
          `;

        recargoPorcentaje = 0;
      }

      renderCarrito();
    }
  );

  // =====================================================
  // TARJETA
  // =====================================================

  tarjeta.addEventListener(
    "change",
    async () => {
      cuotas.innerHTML =
        `
          <option value="">
            Seleccionar...
          </option>
        `;

      recargoPorcentaje = 0;

      if (!tarjeta.value) {
        actualizarTotales();
        return;
      }

      try {
        const response =
          await fetch(
            `/caja/api/tarjetas/${tarjeta.value}/cuotas`
          );

        const opciones =
          await response.json();

        opciones.forEach(
          opcion => {
            const option =
              document.createElement("option");

            option.value =
              opcion.cuotas;

            option.dataset.recargo =
              opcion.recargo_porcentaje;

            option.textContent =
              `${opcion.cuotas} cuota${
                opcion.cuotas === 1
                  ? ""
                  : "s"
              } · ${opcion.recargo_porcentaje}%`;

            cuotas.appendChild(option);
          }
        );

      } catch (error) {
        console.error(error);
      }

      actualizarTotales();
    }
  );

  // =====================================================
  // CUOTAS
  // =====================================================

  cuotas.addEventListener(
    "change",
    () => {
      const option =
        cuotas.options[
          cuotas.selectedIndex
        ];

      recargoPorcentaje =
        Number(
          option
            ? option.dataset.recargo
            : 0
        ) || 0;

      actualizarTotales();
    }
  );

  // =====================================================
  // DESCUENTO
  // =====================================================

  descuento.addEventListener(
    "input",
    actualizarTotales
  );

  // =====================================================
  // FLETE
  // =====================================================

  incluirFlete.addEventListener(
    "change",
    () => {
      fleteBox.style.display =
        incluirFlete.checked
          ? "block"
          : "none";

      actualizarTotales();
    }
  );

  flete.addEventListener(
    "input",
    actualizarTotales
  );

  // =====================================================
  // CONFIRMAR VENTA
  // =====================================================

  document
    .getElementById("formVenta")
    .addEventListener(
      "submit",
      event => {
        if (!ubicacion.value) {
          event.preventDefault();

          alert(
            "Seleccioná el local."
          );

          return;
        }

        if (carrito.length === 0) {
          event.preventDefault();

          alert(
            "Agregá al menos un producto."
          );

          return;
        }

        if (!formaPago.value) {
          event.preventDefault();

          alert(
            "Seleccioná una forma de pago."
          );

          return;
        }

        if (
          tipoPagoActual() ===
          "tarjeta"
        ) {
          if (
            !tarjeta.value ||
            !cuotas.value
          ) {
            event.preventDefault();

            alert(
              "Seleccioná tarjeta y cuotas."
            );

            return;
          }
        }

        itemsJson.value =
          JSON.stringify(
            carrito.map(
              item => ({
                producto_id:
                  item.producto_id,

                cantidad:
                  item.cantidad,

                precio_unitario:
                  obtenerPrecio(item)
              })
            )
          );

        const confirmar =
          confirm(
            `¿Confirmar venta por ${
              document.getElementById(
                "totalVista"
              ).textContent
            }?`
          );

        if (!confirmar) {
          event.preventDefault();
        }
      }
    );

  actualizarTotales();
</script>

</body>
</html>