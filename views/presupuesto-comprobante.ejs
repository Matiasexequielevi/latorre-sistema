<!doctype html><html lang="es"><head><meta charset="utf-8"><title>Presupuesto #<%=presupuesto.numero%></title><style>@page{size:A4;margin:14mm}body{font-family:Arial;color:#111}.actions{display:flex;gap:8px;max-width:900px;margin:18px auto}.btn{padding:10px 14px;background:#111827;color:white;border-radius:8px;text-decoration:none;border:0}.sheet{max-width:900px;margin:auto;padding:20px}.head{display:flex;gap:22px;align-items:center;border-bottom:2px solid #111;padding-bottom:16px}.logo{width:110px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:20px 0}.box{padding:10px;background:#f7f7f7;border-radius:8px}table{width:100%;border-collapse:collapse}th,td{padding:10px;border-bottom:1px solid #ddd;text-align:left}.total{text-align:right;font-size:24px;font-weight:800;margin-top:20px}.foot{margin-top:30px;text-align:center;color:#666;font-size:12px}@media print{.actions{display:none}.sheet{padding:0}}</style></head><body><div class="actions"><button class="btn" onclick="print()">Imprimir A4</button><a class="btn" href="/presupuestos/<%=presupuesto.id%>/pdf" target="_blank">PDF</a><a class="btn" href="/presupuestos/<%=presupuesto.id%>/whatsapp" target="_blank">WhatsApp</a><a class="btn" href="/presupuestos/<%=presupuesto.id%>">Volver</a></div><main class="sheet"><div class="head"><img class="logo" src="/images/logo-la-torre.png"><div><h1>LA TORRE</h1><b>ELECTRO · HOGAR</b><div><%=direccion%><br>Tel. <%=empresa.telefono%> · <%=empresa.instagram%></div></div></div><h2>Presupuesto #<%=presupuesto.numero%></h2><div class="meta"><div class="box"><b>Cliente</b><br><%=presupuesto.cliente_nombre%></div><div class="box"><b>Fecha</b><br><%=new Date(presupuesto.created_at).toLocaleString('es-AR')%></div><div class="box"><b>Sucursal</b><br><%=presupuesto.ubicacion%></div><div class="box"><b>Vendedor</b><br><%=presupuesto.vendedor%></div></div><table><thead><tr><th>Producto</th><th>Cant.</th><th>Precio</th><th>Subtotal</th></tr></thead><tbody><%items.forEach(i=>{%><tr><td><%=i.descripcion%></td><td><%=Number(i.cantidad)%></td><td>$<%=Number(i.precio_unitario).toLocaleString('es-AR')%></td><td>$<%=Number(i.subtotal).toLocaleString('es-AR')%></td></tr><%})%></tbody></table><div class="total">TOTAL: $<%=Number(presupuesto.total).toLocaleString('es-AR')%></div><div class="foot">Presupuesto válido por 7 días, sujeto a disponibilidad y actualización de precios.<br><%=empresa.instagram%> · <%=empresa.telefono%></div></main></body></html>
