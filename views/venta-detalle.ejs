<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    La Torre | Venta #<%= venta.numero %>
  </title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;

      background: #f3f4f6;
      color: #111827;

      font-family:
        "Segoe UI",
        Arial,
        sans-serif;
    }

    .top {
      background: #111827;

      color: white;

      padding: 20px 28px;
    }

    .top h1 {
      margin: 0;

      font-size: 24px;
    }

    .top p {
      margin: 5px 0 0;

      color: #9ca3af;
    }

    .container {
      max-width: 1050px;

      margin: 28px auto;

      padding:
        0 20px 40px;
    }

    .page-header {
      display: flex;

      justify-content:
        space-between;

      align-items:
        flex-start;

      gap: 20px;

      margin-bottom: 20px;
    }

    .page-header h2 {
      margin: 0;

      font-size: 27px;
    }

    .page-header p {
      margin: 7px 0 0;

      color: #6b7280;
    }

    .back {
      color: #374151;

      text-decoration: none;

      font-weight: 700;
    }

    .alert {
      margin-bottom: 18px;

      padding: 13px 16px;

      border-radius: 10px;

      font-size: 14px;
      font-weight: 600;
    }

    .alert-ok {
      background: #ecfdf3;
      color: #067647;

      border:
        1px solid #abefc6;
    }

    .alert-error {
      background: #fef2f2;
      color: #b91c1c;

      border:
        1px solid #fecaca;
    }

    .grid {
      display: grid;

      grid-template-columns:
        1.2fr .8fr;

      gap: 18px;
    }

    .card {
      background: white;

      border:
        1px solid #e5e7eb;

      border-radius: 15px;

      padding: 20px;
    }

    .card h3 {
      margin:
        0 0 17px;

      font-size: 17px;
    }

    .info-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 15px;
    }

    .info-item span {
      display: block;

      color: #6b7280;

      font-size: 11px;
      font-weight: 700;

      text-transform: uppercase;
    }

    .info-item strong {
      display: block;

      margin-top: 5px;

      font-size: 14px;
    }

    .table-card {
      margin-top: 18px;

      background: white;

      border:
        1px solid #e5e7eb;

      border-radius: 15px;

      overflow-x: auto;
    }

    table {
      width: 100%;

      border-collapse: collapse;
    }

    th {
      padding: 12px;

      background: #f9fafb;

      color: #6b7280;

      border-bottom:
        1px solid #e5e7eb;

      text-align: left;

      font-size: 11px;

      text-transform: uppercase;
    }

    td {
      padding: 12px;

      border-bottom:
        1px solid #f0f1f3;

      font-size: 13px;
    }

    .producto {
      font-weight: 700;
    }

    .codigo {
      margin-top: 4px;

      color: #9ca3af;

      font-size: 11px;
    }

    .precio {
      white-space: nowrap;

      font-weight: 700;
    }

    .resumen-row {
      display: flex;

      justify-content:
        space-between;

      gap: 20px;

      margin: 12px 0;

      font-size: 14px;
    }

    .total {
      margin-top: 16px;

      padding-top: 16px;

      border-top:
        2px solid #111827;

      display: flex;

      justify-content:
        space-between;

      gap: 20px;
    }

    .total strong {
      font-size: 25px;
    }

    .badge {
      display: inline-block;

      padding: 6px 9px;

      border-radius: 7px;

      font-size: 12px;
      font-weight: 800;
    }

    .badge-ok {
      background: #ecfdf3;
      color: #067647;
    }

    .badge-anulada {
      background: #fef2f2;
      color: #b91c1c;
    }

    .anular {
      margin-top: 18px;

      padding-top: 18px;

      border-top:
        1px solid #e5e7eb;
    }

    .anular label {
      display: block;

      margin-bottom: 7px;

      color: #374151;

      font-size: 13px;
      font-weight: 700;
    }

    .anular input {
      width: 100%;

      min-height: 43px;

      border:
        1px solid #d1d5db;

      border-radius: 9px;

      padding: 9px 12px;

      font-size: 14px;
    }

    .btn-danger {
      width: 100%;

      min-height: 44px;

      margin-top: 10px;

      border:
        1px solid #fecaca;

      border-radius: 9px;

      background: #b42318;

      color: white;

      font-weight: 800;

      cursor: pointer;
    }

    .observaciones {
      margin-top: 18px;

      white-space: pre-line;

      color: #6b7280;

      font-size: 13px;
    }

    @media (
      max-width: 760px
    ) {

      .grid {
        grid-template-columns:
          1fr;
      }

      .info-grid {
        grid-template-columns:
          1fr;
      }

      .page-header {
        flex-direction: column;
      }

    }

  </style>

</head>

<body>

<header class="top">

  <h1>
    LA TORRE
  </h1>

  <p>
    Sistema Multisucursal
  </p>

</header>

<main class="container">

  <div class="page-header">

    <div>

      <h2>
        Venta #<%= venta.numero %>
      </h2>

      <p>

        <%= new Date(
          venta.created_at
        ).toLocaleString(
          "es-AR"
        ) %>

      </p>

    </div>

    <a
      href="/ventas"
      class="back"
    >
      ← Volver a ventas
    </a>

  </div>

  <% if (mensaje) { %>

    <div class="alert alert-ok">
      <%= mensaje %>
    </div>

  <% } %>

  <% if (error) { %>

    <div class="alert alert-error">
      <%= error %>
    </div>

  <% } %>

  <div class="grid">

    <section class="card">

      <h3>
        Datos de la venta
      </h3>

      <div class="info-grid">

        <div class="info-item">

          <span>
            Estado
          </span>

          <strong>

            <% if (
              venta.estado ===
              "confirmada"
            ) { %>

              <span class="badge badge-ok">
                Confirmada
              </span>

            <% } else { %>

              <span class="badge badge-anulada">
                Anulada
              </span>

            <% } %>

          </strong>

        </div>

        <div class="info-item">

          <span>
            Sucursal
          </span>

          <strong>
            <%= venta.ubicacion %>
          </strong>

        </div>

        <div class="info-item">

          <span>
            Vendedor
          </span>

          <strong>
            <%= venta.vendedor %>
          </strong>

        </div>

        <div class="info-item">

          <span>
            Forma de pago
          </span>

          <strong>
            <%= venta.forma_pago || "-" %>
          </strong>

        </div>

        <div class="info-item">

          <span>
            Cliente
          </span>

          <strong>
            <%= venta.cliente_nombre || "Consumidor final" %>
          </strong>

        </div>

        <div class="info-item">

          <span>
            DNI / CUIT
          </span>

          <strong>
            <%= venta.cliente_documento || "-" %>
          </strong>

        </div>

        <div class="info-item">

          <span>
            Teléfono
          </span>

          <strong>
            <%= venta.cliente_telefono || "-" %>
          </strong>

        </div>

        <% if (
          venta.tarjeta
        ) { %>

          <div class="info-item">

            <span>
              Financiación
            </span>

            <strong>

              <%= venta.tarjeta %>

              <% if (
                venta.cuotas
              ) { %>

                · <%= venta.cuotas %> cuotas

              <% } %>

            </strong>

          </div>

        <% } %>

      </div>

      <% if (
        venta.observaciones
      ) { %>

        <div class="observaciones">

          <strong>
            Observaciones
          </strong>

          <br>

          <%= venta.observaciones %>

        </div>

      <% } %>

    </section>

    <aside class="card">

      <h3>
        Totales
      </h3>

      <div class="resumen-row">

        <span>
          Subtotal
        </span>

        <strong>

          $<%= Number(
            venta.subtotal
          ).toLocaleString(
            "es-AR",
            {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }
          ) %>

        </strong>

      </div>

      <div class="resumen-row">

        <span>
          Descuento
        </span>

        <strong>

          - $<%= Number(
            venta.descuento
          ).toLocaleString(
            "es-AR",
            {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }
          ) %>

        </strong>

      </div>

      <div class="resumen-row">

        <span>
          Recargo
        </span>

        <strong>

          + $<%= Number(
            venta.recargo
          ).toLocaleString(
            "es-AR",
            {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }
          ) %>

        </strong>

      </div>

      <div class="total">

        <span>
          TOTAL
        </span>

        <strong>

          $<%= Number(
            venta.total
          ).toLocaleString(
            "es-AR",
            {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }
          ) %>

        </strong>

      </div>

      <% if (
        usuario.rol === "dueno" &&
        venta.estado === "confirmada"
      ) { %>

        <div class="anular">

          <form
            action="/ventas/<%= venta.id %>/anular"
            method="POST"
            onsubmit="return confirmarAnulacion();"
          >

            <label>
              Motivo de anulación
            </label>

            <input
              id="motivo"
              type="text"
              name="motivo"
              placeholder="Ej: Venta cargada por error"
              required
            >

            <button
              type="submit"
              class="btn-danger"
            >
              Anular venta y devolver stock
            </button>

          </form>

        </div>

      <% } %>

    </aside>

  </div>

  <section class="table-card">

    <table>

      <thead>

        <tr>

          <th>
            Producto
          </th>

          <th>
            Cantidad
          </th>

          <th>
            Precio unitario
          </th>

          <th>
            Subtotal
          </th>

        </tr>

      </thead>

      <tbody>

        <% items.forEach(
          item => {
        %>

          <tr>

            <td>

              <div class="producto">
                <%= item.descripcion %>
              </div>

              <div class="codigo">

                <%= item.codigo_interno || item.codigo_barras || "-" %>

              </div>

            </td>

            <td>
              <%= Number(item.cantidad) %>
            </td>

            <td class="precio">

              $<%= Number(
                item.precio_unitario
              ).toLocaleString(
                "es-AR",
                {
                  minimumFractionDigits: 2,
                  maximumFractionDigits: 2
                }
              ) %>

            </td>

            <td class="precio">

              $<%= Number(
                item.subtotal
              ).toLocaleString(
                "es-AR",
                {
                  minimumFractionDigits: 2,
                  maximumFractionDigits: 2
                }
              ) %>

            </td>

          </tr>

        <% }) %>

      </tbody>

    </table>

  </section>

</main>

<script>

  function confirmarAnulacion() {

    const motivo =
      document.getElementById(
        "motivo"
      ).value.trim();

    if (!motivo) {

      alert(
        "Ingresá el motivo de la anulación."
      );

      return false;

    }

    return confirm(
      "¿Seguro que querés anular esta venta? El stock será devuelto automáticamente."
    );

  }

</script>

</body>
</html>