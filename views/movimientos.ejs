<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    La Torre | Historial
  </title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f3f4f6;
      color: #111827;
      font-family: "Segoe UI", Arial, sans-serif;
    }

    .topbar {
      min-height: 72px;
      background: #111827;
      color: white;
      padding: 0 26px;

      display: flex;
      justify-content: space-between;
      align-items: center;

      gap: 20px;
    }

    .brand h1 {
      margin: 0;
      font-size: 24px;
    }

    .brand span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .usuario {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .usuario-info {
      text-align: right;
    }

    .usuario-info strong {
      display: block;
      font-size: 14px;
    }

    .usuario-info span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .logout {
      border: 1px solid #374151;
      border-radius: 9px;
      padding: 9px 12px;
      background: #1f2937;
      color: white;
      cursor: pointer;
    }

    .layout {
      display: flex;
      min-height: calc(100vh - 72px);
    }

    .sidebar {
      width: 235px;
      flex-shrink: 0;
      background: white;
      border-right: 1px solid #e5e7eb;
      padding: 20px 14px;
    }

    .sidebar a {
      display: block;
      margin-bottom: 5px;
      padding: 12px 14px;
      border-radius: 9px;
      text-decoration: none;
      color: #374151;
      font-size: 14px;
      font-weight: 600;
    }

    .sidebar a:hover {
      background: #f3f4f6;
    }

    .sidebar a.active {
      background: #111827;
      color: white;
    }

    .separator {
      height: 1px;
      margin: 14px 8px;
      background: #e5e7eb;
    }

    .content {
      flex: 1;
      min-width: 0;
      padding: 28px;
    }

    .page-header {
      margin-bottom: 20px;
    }

    .page-header h2 {
      margin: 0;
      font-size: 28px;
    }

    .page-header p {
      margin: 7px 0 0;
      color: #6b7280;
    }

    .cards {
      display: grid;
      grid-template-columns:
        repeat(
          3,
          minmax(0, 1fr)
        );
      gap: 15px;
      margin-bottom: 18px;
    }

    .card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 18px;
    }

    .card .label {
      color: #6b7280;
      font-size: 12px;
      font-weight: 700;
    }

    .card .value {
      margin-top: 8px;
      font-size: 27px;
      font-weight: 800;
    }

    .entrada {
      color: #067647;
    }

    .salida {
      color: #b42318;
    }

    .filters {
      display: grid;
      grid-template-columns:
        1.4fr
        repeat(
          4,
          minmax(150px, .6fr)
        )
        auto;
      gap: 10px;
      padding: 15px;
      margin-bottom: 18px;
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
    }

    input,
    select {
      width: 100%;
      min-height: 42px;
      padding: 8px 11px;
      border: 1px solid #d1d5db;
      border-radius: 9px;
      background: white;
      font-size: 13px;
    }

    .btn {
      min-height: 42px;
      padding: 0 14px;
      border: none;
      border-radius: 9px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-primary {
      background: #111827;
      color: white;
    }

    .table-card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      overflow-x: auto;
    }

    table {
      width: 100%;
      min-width: 1250px;
      border-collapse: collapse;
    }

    th {
      padding: 12px;
      background: #f9fafb;
      color: #6b7280;
      border-bottom: 1px solid #e5e7eb;
      text-align: left;
      font-size: 11px;
      text-transform: uppercase;
    }

    td {
      padding: 12px;
      border-bottom: 1px solid #f0f1f3;
      font-size: 13px;
      vertical-align: middle;
    }

    .producto {
      font-weight: 800;
    }

    .codigo {
      margin-top: 4px;
      color: #9ca3af;
      font-size: 11px;
    }

    .cantidad {
      font-weight: 900;
      white-space: nowrap;
    }

    .badge {
      display: inline-block;
      padding: 5px 8px;
      border-radius: 7px;
      font-size: 11px;
      font-weight: 800;
    }

    .tipo-venta {
      background: #fef2f2;
      color: #b91c1c;
    }

    .tipo-ingreso {
      background: #ecfdf3;
      color: #067647;
    }

    .tipo-transferencia {
      background: #eff8ff;
      color: #175cd3;
    }

    .tipo-ajuste {
      background: #fff7ed;
      color: #c2410c;
    }

    .tipo-anulacion {
      background: #f3e8ff;
      color: #7e22ce;
    }

    .stock-change {
      white-space: nowrap;
      font-weight: 700;
    }

    .observacion {
      max-width: 300px;
      color: #6b7280;
    }

    .empty {
      padding: 45px;
      text-align: center;
      color: #9ca3af;
    }

    @media(max-width:1100px) {

      .filters {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }

    @media(max-width:760px) {

      .sidebar {
        display: none;
      }

      .content {
        padding: 18px;
      }

      .topbar {
        padding: 14px 18px;
      }

      .cards,
      .filters {
        grid-template-columns: 1fr;
      }

    }

  </style>

</head>

<body>

<header class="topbar">

  <div class="brand">

    <h1>
      LA TORRE
    </h1>

    <span>
      Sistema Multisucursal
    </span>

  </div>

  <div class="usuario">

    <div class="usuario-info">

      <strong>
        <%= usuario.nombre %>
      </strong>

      <span>

        <% if (
          usuario.rol === "dueno"
        ) { %>

          Dueño · Todas las ubicaciones

        <% } else { %>

          <%= usuario.ubicacion %>

        <% } %>

      </span>

    </div>

    <form
      action="/logout"
      method="POST"
    >

      <button
        class="logout"
        type="submit"
      >
        Salir
      </button>

    </form>

  </div>

</header>

<div class="layout">

  <aside class="sidebar">

    <a href="/dashboard">
      Inicio
    </a>

    <a href="/caja">
      Caja
    </a>

    <a href="/ventas">
      Ventas
    </a>

    <a href="/presupuestos">
      Presupuestos
    </a>

    <div class="separator"></div>

    <a href="/productos">
      Productos
    </a>

    <a href="/stock">
      Stock
    </a>

    <a href="/transferencias">
      Transferencias
    </a>

    <a href="/ingresos">
      Ingreso de mercadería
    </a>

    <div class="separator"></div>

    <a href="/reportes">
      Reportes
    </a>

    <a
      href="/movimientos"
      class="active"
    >
      Historial
    </a>

    <% if (
      usuario.rol === "dueno"
    ) { %>

      <a href="/tarjetas">
        Tarjetas y cuotas
      </a>

    <% } %>

  </aside>

  <main class="content">

    <div class="page-header">

      <h2>
        Historial de movimientos
      </h2>

      <p>

        <% if (
          usuario.rol === "dueno"
        ) { %>

          Trazabilidad completa de Florida, Delfín Gallo y Depósito.

        <% } else { %>

          Movimientos registrados en <%= usuario.ubicacion %>.

        <% } %>

      </p>

    </div>

    <section class="cards">

      <div class="card">

        <div class="label">
          MOVIMIENTOS
        </div>

        <div class="value">
          <%= resumen.cantidadMovimientos %>
        </div>

      </div>

      <div class="card">

        <div class="label">
          ENTRADAS
        </div>

        <div class="value entrada">
          +<%= resumen.entradas %>
        </div>

      </div>

      <div class="card">

        <div class="label">
          SALIDAS
        </div>

        <div class="value salida">
          -<%= resumen.salidas %>
        </div>

      </div>

    </section>

    <form
      method="GET"
      action="/movimientos"
      class="filters"
    >

      <input
        type="search"
        name="buscar"
        value="<%= filtros.buscar %>"
        placeholder="Producto, código, usuario, referencia..."
      >

      <input
        type="date"
        name="desde"
        value="<%= filtros.desde %>"
      >

      <input
        type="date"
        name="hasta"
        value="<%= filtros.hasta %>"
      >

      <% if (
        usuario.rol === "dueno"
      ) { %>

        <select
          name="ubicacion_id"
        >

          <option value="">
            Todas las ubicaciones
          </option>

          <% ubicaciones.forEach(
            ubicacion => {
          %>

            <option
              value="<%= ubicacion.id %>"
              <%= Number(filtros.ubicacionId) === Number(ubicacion.id) ? "selected" : "" %>
            >
              <%= ubicacion.nombre %>
            </option>

          <% }) %>

        </select>

      <% } %>

      <select
        name="tipo"
      >

        <option value="">
          Todos los movimientos
        </option>

        <option
          value="venta"
          <%= filtros.tipo === "venta" ? "selected" : "" %>
        >
          Venta
        </option>

        <option
          value="ingreso_mercaderia"
          <%= filtros.tipo === "ingreso_mercaderia" ? "selected" : "" %>
        >
          Ingreso mercadería
        </option>

        <option
          value="transferencia_entrada"
          <%= filtros.tipo === "transferencia_entrada" ? "selected" : "" %>
        >
          Transferencia entrada
        </option>

        <option
          value="transferencia_salida"
          <%= filtros.tipo === "transferencia_salida" ? "selected" : "" %>
        >
          Transferencia salida
        </option>

        <option
          value="ajuste_positivo"
          <%= filtros.tipo === "ajuste_positivo" ? "selected" : "" %>
        >
          Ajuste positivo
        </option>

        <option
          value="ajuste_negativo"
          <%= filtros.tipo === "ajuste_negativo" ? "selected" : "" %>
        >
          Ajuste negativo
        </option>

        <option
          value="anulacion_venta"
          <%= filtros.tipo === "anulacion_venta" ? "selected" : "" %>
        >
          Anulación de venta
        </option>

      </select>

      <button
        class="btn btn-primary"
        type="submit"
      >
        Filtrar
      </button>

    </form>

    <section class="table-card">

      <% if (
        movimientos.length === 0
      ) { %>

        <div class="empty">
          No hay movimientos para mostrar.
        </div>

      <% } else { %>

        <table>

          <thead>

            <tr>

              <th>
                Fecha
              </th>

              <th>
                Producto
              </th>

              <th>
                Ubicación
              </th>

              <th>
                Movimiento
              </th>

              <th>
                Cantidad
              </th>

              <th>
                Stock
              </th>

              <th>
                Referencia
              </th>

              <th>
                Usuario
              </th>

              <th>
                Observación
              </th>

            </tr>

          </thead>

          <tbody>

            <% movimientos.forEach(
              movimiento => {

                let claseTipo =
                  "tipo-ajuste";

                if (
                  movimiento.tipo ===
                  "venta"
                ) {
                  claseTipo =
                    "tipo-venta";
                }

                if (
                  movimiento.tipo ===
                  "ingreso_mercaderia"
                ) {
                  claseTipo =
                    "tipo-ingreso";
                }

                if (
                  movimiento.tipo.includes(
                    "transferencia"
                  )
                ) {
                  claseTipo =
                    "tipo-transferencia";
                }

                if (
                  movimiento.tipo ===
                  "anulacion_venta"
                ) {
                  claseTipo =
                    "tipo-anulacion";
                }

                const nombres = {
                  venta:
                    "Venta",

                  ingreso_mercaderia:
                    "Ingreso",

                  transferencia_entrada:
                    "Transferencia entrada",

                  transferencia_salida:
                    "Transferencia salida",

                  ajuste_positivo:
                    "Ajuste +",

                  ajuste_negativo:
                    "Ajuste -",

                  devolucion:
                    "Devolución",

                  anulacion_venta:
                    "Anulación venta",
                };
            %>

              <tr>

                <td>

                  <%= new Date(
                    movimiento.created_at
                  ).toLocaleString(
                    "es-AR"
                  ) %>

                </td>

                <td>

                  <div class="producto">
                    <%= movimiento.producto %>
                  </div>

                  <div class="codigo">

                    <%= movimiento.codigo_interno || movimiento.codigo_barras || "-" %>

                  </div>

                </td>

                <td>
                  <strong>
                    <%= movimiento.ubicacion %>
                  </strong>
                </td>

                <td>

                  <span
                    class="badge <%= claseTipo %>"
                  >

                    <%= nombres[movimiento.tipo] || movimiento.tipo %>

                  </span>

                </td>

                <td>

                  <% if (
                    Number(
                      movimiento.cantidad
                    ) > 0
                  ) { %>

                    <span class="cantidad entrada">

                      +<%= Number(
                        movimiento.cantidad
                      ) %>

                    </span>

                  <% } else { %>

                    <span class="cantidad salida">

                      <%= Number(
                        movimiento.cantidad
                      ) %>

                    </span>

                  <% } %>

                </td>

                <td class="stock-change">

                  <%= Number(
                    movimiento.stock_anterior
                  ) %>

                  →

                  <%= Number(
                    movimiento.stock_nuevo
                  ) %>

                </td>

                <td>

                  <% if (
                    movimiento.referencia_tipo
                  ) { %>

                    <strong>
                      <%= movimiento.referencia_tipo %>
                    </strong>

                    <% if (
                      movimiento.referencia_id
                    ) { %>

                      #<%= movimiento.referencia_id %>

                    <% } %>

                  <% } else { %>

                    -

                  <% } %>

                </td>

                <td>
                  <%= movimiento.usuario || "-" %>
                </td>

                <td class="observacion">
                  <%= movimiento.observaciones || "-" %>
                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      <% } %>

    </section>

  </main>

</div>

</body>
</html>