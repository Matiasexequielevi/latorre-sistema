<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    La Torre | Reportes
  </title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f3f4f6;
      color: #111827;
      font-family: "Segoe UI", Arial, sans-serif;
    }

    .topbar {
      min-height: 72px;
      background: #111827;
      color: white;
      padding: 0 26px;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand h1 {
      margin: 0;
      font-size: 24px;
    }

    .brand span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .usuario {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .usuario-info {
      text-align: right;
    }

    .usuario-info strong {
      display: block;
      font-size: 14px;
    }

    .usuario-info span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .logout {
      border: 1px solid #374151;
      border-radius: 9px;
      padding: 9px 12px;
      background: #1f2937;
      color: white;
      cursor: pointer;
    }

    .layout {
      display: flex;
      min-height: calc(100vh - 72px);
    }

    .sidebar {
      width: 235px;
      flex-shrink: 0;
      background: white;
      border-right: 1px solid #e5e7eb;
      padding: 20px 14px;
    }

    .sidebar a {
      display: block;
      margin-bottom: 5px;
      padding: 12px 14px;
      border-radius: 9px;
      text-decoration: none;
      color: #374151;
      font-size: 14px;
      font-weight: 600;
    }

    .sidebar a:hover {
      background: #f3f4f6;
    }

    .sidebar a.active {
      background: #111827;
      color: white;
    }

    .separator {
      height: 1px;
      margin: 14px 8px;
      background: #e5e7eb;
    }

    .content {
      flex: 1;
      min-width: 0;
      padding: 28px;
    }

    .page-header {
      margin-bottom: 20px;
    }

    .page-header h2 {
      margin: 0;
      font-size: 28px;
    }

    .page-header p {
      margin: 7px 0 0;
      color: #6b7280;
    }

    .filters {
      display: grid;
      grid-template-columns:
        repeat(3, minmax(170px, 1fr))
        auto;
      gap: 10px;

      padding: 15px;

      background: white;

      border:
        1px solid #e5e7eb;

      border-radius: 14px;

      margin-bottom: 18px;
    }

    input,
    select {
      width: 100%;
      min-height: 42px;
      padding: 8px 11px;

      border:
        1px solid #d1d5db;

      border-radius: 9px;

      background: white;
      font-size: 13px;
    }

    .btn {
      min-height: 42px;
      padding: 0 15px;
      border: none;
      border-radius: 9px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-primary {
      background: #111827;
      color: white;
    }

    .cards {
      display: grid;

      grid-template-columns:
        repeat(
          4,
          minmax(0, 1fr)
        );

      gap: 15px;

      margin-bottom: 18px;
    }

    .card {
      background: white;

      border:
        1px solid #e5e7eb;

      border-radius: 14px;

      padding: 18px;
    }

    .card .label {
      color: #6b7280;
      font-size: 12px;
      font-weight: 700;
    }

    .card .value {
      margin-top: 8px;
      font-size: 25px;
      font-weight: 900;
    }

    .ganancia {
      color: #067647;
    }

    .costo {
      color: #b54708;
    }

    .grid-2 {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 18px;

      margin-bottom: 18px;
    }

    .panel {
      background: white;

      border:
        1px solid #e5e7eb;

      border-radius: 14px;

      overflow: hidden;
    }

    .panel-header {
      padding: 16px 18px;

      border-bottom:
        1px solid #e5e7eb;

      font-weight: 800;
    }

    .table-scroll {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th {
      padding: 11px 12px;

      background: #f9fafb;

      border-bottom:
        1px solid #e5e7eb;

      color: #6b7280;

      text-align: left;

      font-size: 11px;

      text-transform: uppercase;
    }

    td {
      padding: 11px 12px;

      border-bottom:
        1px solid #f0f1f3;

      font-size: 13px;
    }

    .precio {
      white-space: nowrap;
      font-weight: 800;
    }

    .producto {
      font-weight: 700;
    }

    .muted {
      margin-top: 3px;

      color: #9ca3af;

      font-size: 11px;
    }

    .empty {
      padding: 35px;
      text-align: center;
      color: #9ca3af;
    }

    @media(max-width:1100px) {

      .cards {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }

    @media(max-width:800px) {

      .sidebar {
        display: none;
      }

      .content {
        padding: 18px;
      }

      .topbar {
        padding: 14px 18px;
      }

      .filters,
      .cards,
      .grid-2 {
        grid-template-columns: 1fr;
      }

    }

  </style>

</head>

<body>

<header class="topbar">

  <div class="brand">

    <h1>
      LA TORRE
    </h1>

    <span>
      Sistema Multisucursal
    </span>

  </div>

  <div class="usuario">

    <div class="usuario-info">

      <strong>
        <%= usuario.nombre %>
      </strong>

      <span>
        Dueño · Todas las ubicaciones
      </span>

    </div>

    <form
      action="/logout"
      method="POST"
    >

      <button
        class="logout"
        type="submit"
      >
        Salir
      </button>

    </form>

  </div>

</header>

<div class="layout">

  <aside class="sidebar">

    <a href="/dashboard">
      Inicio
    </a>

    <a href="/caja">
      Caja
    </a>

      <a href="/cajas">Cajas / Arqueo</a>

    <a href="/ventas">
      Ventas
    </a>

    <a href="/presupuestos">
      Presupuestos
    </a>

    <div class="separator"></div>

    <a href="/productos">
      Productos
    </a>

    <a href="/stock">
      Stock
    </a>

    <a href="/transferencias">
      Transferencias
    </a>

    <a href="/ingresos">
      Ingreso de mercadería
    </a>

    <div class="separator"></div>

    <a
      href="/reportes"
      class="active"
    >
      Reportes
    </a>

    <a href="/movimientos">
      Historial
    </a>

    <a href="/tarjetas">
      Tarjetas y cuotas
    </a>

  </aside>

  <main class="content">

    <div class="page-header">

      <h2>
        Reportes
      </h2>

      <p>
        Ventas, rentabilidad y valorización de stock.
      </p>

    </div>

    <form
      method="GET"
      action="/reportes"
      class="filters"
    >

      <input
        type="date"
        name="desde"
        value="<%= filtros.desde %>"
      >

      <input
        type="date"
        name="hasta"
        value="<%= filtros.hasta %>"
      >

      <select
        name="sucursal_id"
      >

        <option value="">
          Todas las sucursales
        </option>

        <% sucursales.forEach(
          sucursal => {
        %>

          <option
            value="<%= sucursal.id %>"
            <%= Number(filtros.sucursalId) === Number(sucursal.id) ? "selected" : "" %>
          >
            <%= sucursal.nombre %>
          </option>

        <% }) %>

      </select>

      <button
        class="btn btn-primary"
        type="submit"
      >
        Aplicar
      </button>

    </form>

    <section class="cards">

      <div class="card">

        <div class="label">
          FACTURACIÓN
        </div>

        <div class="value">

          $<%= Number(
            resumen.facturacion
          ).toLocaleString(
            "es-AR",
            {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }
          ) %>

        </div>

      </div>

      <div class="card">

        <div class="label">
          VENTAS
        </div>

        <div class="value">
          <%= resumen.cantidadVentas %>
        </div>

      </div>

      <div class="card">

        <div class="label">
          COSTO ESTIMADO
        </div>

        <div class="value costo">

          $<%= Number(
            resumen.costoEstimado
          ).toLocaleString(
            "es-AR",
            {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }
          ) %>

        </div>

      </div>

      <div class="card">

        <div class="label">
          GANANCIA ESTIMADA
        </div>

        <div class="value ganancia">

          $<%= Number(
            resumen.gananciaEstimada
          ).toLocaleString(
            "es-AR",
            {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }
          ) %>

        </div>

      </div>

    </section>

    <section class="cards">

      <div class="card">

        <div class="label">
          SUBTOTAL
        </div>

        <div class="value">

          $<%= Number(
            resumen.subtotal
          ).toLocaleString(
            "es-AR",
            {
              maximumFractionDigits: 2
            }
          ) %>

        </div>

      </div>

      <div class="card">

        <div class="label">
          DESCUENTOS
        </div>

        <div class="value">

          $<%= Number(
            resumen.descuentos
          ).toLocaleString(
            "es-AR",
            {
              maximumFractionDigits: 2
            }
          ) %>

        </div>

      </div>

      <div class="card">

        <div class="label">
          RECARGOS
        </div>

        <div class="value">

          $<%= Number(
            resumen.recargos
          ).toLocaleString(
            "es-AR",
            {
              maximumFractionDigits: 2
            }
          ) %>

        </div>

      </div>

      <div class="card">

        <div class="label">
          MARGEN ESTIMADO
        </div>

        <div class="value">

          <% if (
            resumen.facturacion > 0
          ) { %>

            <%= (
              resumen.gananciaEstimada /
              resumen.facturacion *
              100
            ).toFixed(2) %>%

          <% } else { %>

            0%

          <% } %>

        </div>

      </div>

    </section>

    <div class="grid-2">

      <section class="panel">

        <div class="panel-header">
          Ventas por sucursal
        </div>

        <% if (
          porSucursal.length === 0
        ) { %>

          <div class="empty">
            Sin ventas en el período.
          </div>

        <% } else { %>

          <table>

            <thead>

              <tr>

                <th>
                  Sucursal
                </th>

                <th>
                  Ventas
                </th>

                <th>
                  Total
                </th>

              </tr>

            </thead>

            <tbody>

              <% porSucursal.forEach(
                item => {
              %>

                <tr>

                  <td>
                    <strong>
                      <%= item.sucursal %>
                    </strong>
                  </td>

                  <td>
                    <%= item.cantidad_ventas %>
                  </td>

                  <td class="precio">

                    $<%= Number(
                      item.total
                    ).toLocaleString(
                      "es-AR",
                      {
                        maximumFractionDigits: 2
                      }
                    ) %>

                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        <% } %>

      </section>

      <section class="panel">

        <div class="panel-header">
          Formas de pago
        </div>

        <% if (
          formasPago.length === 0
        ) { %>

          <div class="empty">
            Sin operaciones.
          </div>

        <% } else { %>

          <table>

            <thead>

              <tr>

                <th>
                  Forma
                </th>

                <th>
                  Ventas
                </th>

                <th>
                  Total
                </th>

              </tr>

            </thead>

            <tbody>

              <% formasPago.forEach(
                item => {
              %>

                <tr>

                  <td>
                    <strong>
                      <%= item.forma_pago %>
                    </strong>
                  </td>

                  <td>
                    <%= item.cantidad %>
                  </td>

                  <td class="precio">

                    $<%= Number(
                      item.total
                    ).toLocaleString(
                      "es-AR",
                      {
                        maximumFractionDigits: 2
                      }
                    ) %>

                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        <% } %>

      </section>

    </div>

    <div class="grid-2">

      <section class="panel">

        <div class="panel-header">
          Productos más vendidos
        </div>

        <% if (
          productosVendidos.length === 0
        ) { %>

          <div class="empty">
            No hay ventas registradas.
          </div>

        <% } else { %>

          <div class="table-scroll">

            <table>

              <thead>

                <tr>

                  <th>
                    Producto
                  </th>

                  <th>
                    Cantidad
                  </th>

                  <th>
                    Facturación
                  </th>

                </tr>

              </thead>

              <tbody>

                <% productosVendidos.forEach(
                  item => {
                %>

                  <tr>

                    <td>

                      <div class="producto">
                        <%= item.descripcion %>
                      </div>

                      <div class="muted">
                        <%= item.codigo_interno || "-" %>
                      </div>

                    </td>

                    <td>
                      <strong>
                        <%= Number(
                          item.cantidad_vendida
                        ) %>
                      </strong>
                    </td>

                    <td class="precio">

                      $<%= Number(
                        item.facturacion
                      ).toLocaleString(
                        "es-AR",
                        {
                          maximumFractionDigits: 2
                        }
                      ) %>

                    </td>

                  </tr>

                <% }) %>

              </tbody>

            </table>

          </div>

        <% } %>

      </section>

      <section class="panel">

        <div class="panel-header">
          Stock valorizado
        </div>

        <table>

          <thead>

            <tr>

              <th>
                Ubicación
              </th>

              <th>
                Unidades
              </th>

              <th>
                Valor costo
              </th>

              <th>
                Valor venta
              </th>

            </tr>

          </thead>

          <tbody>

            <% stockValorizado.forEach(
              item => {
            %>

              <tr>

                <td>
                  <strong>
                    <%= item.ubicacion %>
                  </strong>
                </td>

                <td>
                  <%= Number(
                    item.unidades
                  ) %>
                </td>

                <td class="precio">

                  $<%= Number(
                    item.valor_costo
                  ).toLocaleString(
                    "es-AR",
                    {
                      maximumFractionDigits: 2
                    }
                  ) %>

                </td>

                <td class="precio">

                  $<%= Number(
                    item.valor_venta
                  ).toLocaleString(
                    "es-AR",
                    {
                      maximumFractionDigits: 2
                    }
                  ) %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </section>

    </div>

    <section class="panel">

      <div class="panel-header">
        Últimas ventas del período
      </div>

      <% if (
        ultimasVentas.length === 0
      ) { %>

        <div class="empty">
          Sin ventas.
        </div>

      <% } else { %>

        <div class="table-scroll">

          <table>

            <thead>

              <tr>

                <th>
                  Venta
                </th>

                <th>
                  Fecha
                </th>

                <th>
                  Sucursal
                </th>

                <th>
                  Cliente
                </th>

                <th>
                  Vendedor
                </th>

                <th>
                  Total
                </th>

              </tr>

            </thead>

            <tbody>

              <% ultimasVentas.forEach(
                venta => {
              %>

                <tr>

                  <td>
                    <strong>
                      #<%= venta.numero %>
                    </strong>
                  </td>

                  <td>

                    <%= new Date(
                      venta.created_at
                    ).toLocaleString(
                      "es-AR"
                    ) %>

                  </td>

                  <td>
                    <%= venta.sucursal %>
                  </td>

                  <td>
                    <%= venta.cliente %>
                  </td>

                  <td>
                    <%= venta.vendedor %>
                  </td>

                  <td class="precio">

                    $<%= Number(
                      venta.total
                    ).toLocaleString(
                      "es-AR",
                      {
                        maximumFractionDigits: 2
                      }
                    ) %>

                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        </div>

      <% } %>

    </section>

  </main>

</div>

</body>
</html>