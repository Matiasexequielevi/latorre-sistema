<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    La Torre | Productos
  </title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f3f4f6;
      color: #111827;
      font-family: "Segoe UI", Arial, sans-serif;
    }

    .topbar {
      min-height: 72px;
      background: #111827;
      color: white;

      padding: 0 26px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;
    }

    .brand h1 {
      margin: 0;
      font-size: 24px;
    }

    .brand span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .usuario {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .usuario-info {
      text-align: right;
    }

    .usuario-info strong {
      display: block;
      font-size: 14px;
    }

    .usuario-info span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .logout {
      border: 1px solid #374151;
      border-radius: 9px;
      padding: 9px 12px;
      background: #1f2937;
      color: white;
      cursor: pointer;
    }

    .layout {
      display: flex;
      min-height: calc(100vh - 72px);
    }

    .sidebar {
      width: 235px;
      flex-shrink: 0;

      background: white;

      border-right:
        1px solid #e5e7eb;

      padding: 20px 14px;
    }

    .sidebar a {
      display: block;

      margin-bottom: 5px;

      padding: 12px 14px;

      border-radius: 9px;

      text-decoration: none;

      color: #374151;

      font-size: 14px;
      font-weight: 600;
    }

    .sidebar a:hover {
      background: #f3f4f6;
    }

    .sidebar .active {
      background: #111827;
      color: white;
    }

    .separator {
      height: 1px;
      margin: 14px 8px;
      background: #e5e7eb;
    }

    .content {
      flex: 1;
      min-width: 0;
      padding: 28px;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;

      gap: 20px;

      margin-bottom: 22px;
    }

    .page-header h2 {
      margin: 0;
      font-size: 28px;
    }

    .page-header p {
      margin: 7px 0 0;
      color: #6b7280;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      min-height: 42px;

      padding: 0 16px;

      border: none;
      border-radius: 10px;

      text-decoration: none;

      font-size: 14px;
      font-weight: 700;

      cursor: pointer;
    }

    .btn-primary {
      background: #111827;
      color: white;
    }

    .btn-light {
      background: white;
      color: #374151;
      border: 1px solid #d1d5db;
    }

    .btn-danger {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }

    .filters {
      background: white;

      border: 1px solid #e5e7eb;
      border-radius: 14px;

      padding: 16px;

      margin-bottom: 18px;

      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .search {
      flex: 1;
      min-width: 250px;

      height: 43px;

      padding: 0 14px;

      border: 1px solid #d1d5db;
      border-radius: 10px;

      font-size: 14px;
      outline: none;
    }

    .search:focus {
      border-color: #111827;
    }

    select {
      height: 43px;

      padding: 0 12px;

      border: 1px solid #d1d5db;
      border-radius: 10px;

      background: white;
    }

    .table-card {
      background: white;

      border:
        1px solid #e5e7eb;

      border-radius: 14px;

      overflow: hidden;
    }

    .table-scroll {
      overflow-x: auto;
    }

    table {
      width: 100%;
      min-width: 1250px;

      border-collapse: collapse;
    }

    th {
      padding: 13px 12px;

      background: #f9fafb;

      border-bottom:
        1px solid #e5e7eb;

      text-align: left;

      color: #6b7280;

      font-size: 11px;
      text-transform: uppercase;
    }

    td {
      padding: 13px 12px;

      border-bottom:
        1px solid #f0f1f3;

      vertical-align: middle;

      font-size: 13px;
    }

    tr:last-child td {
      border-bottom: none;
    }

    .producto {
      font-weight: 700;
      color: #111827;
    }

    .muted {
      color: #9ca3af;
      font-size: 12px;
    }

    .precio {
      white-space: nowrap;
      font-weight: 600;
    }

    .stock {
      text-align: center;
      font-weight: 700;
    }

    .stock-total {
      background: #f3f4f6;

      padding: 5px 9px;

      border-radius: 7px;

      display: inline-block;
    }

    .acciones {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .acciones form {
      margin: 0;
    }

    .btn-small {
      min-height: 32px;
      padding: 0 10px;
      font-size: 12px;
      border-radius: 7px;
    }

    .empty {
      padding: 50px 20px;
      text-align: center;
      color: #9ca3af;
    }

    @media (max-width: 760px) {

      .sidebar {
        display: none;
      }

      .content {
        padding: 18px;
      }

      .page-header {
        flex-direction: column;
      }

      .topbar {
        padding: 14px 18px;
      }

    }

  </style>

</head>

<body>

<header class="topbar">

  <div class="brand">

    <h1>
      LA TORRE
    </h1>

    <span>
      Sistema Multisucursal
    </span>

  </div>

  <div class="usuario">

    <div class="usuario-info">

      <strong>
        <%= usuario.nombre %>
      </strong>

      <span>

        <% if (usuario.rol === "dueno") { %>

          Dueño · Todas las ubicaciones

        <% } else { %>

          <%= usuario.ubicacion %>

        <% } %>

      </span>

    </div>

    <form
      action="/logout"
      method="POST"
    >

      <button
        class="logout"
        type="submit"
      >
        Salir
      </button>

    </form>

  </div>

</header>

<div class="layout">

  <aside class="sidebar">

    <a href="/dashboard">
      Inicio
    </a>

    <a href="/caja">
      Caja
    </a>

      <a href="/cajas">Cajas / Arqueo</a>

    <a href="/ventas">
      Ventas
    </a>

    <a href="/presupuestos">
      Presupuestos
    </a>

    <div class="separator"></div>

    <a
      href="/productos"
      class="active"
    >
      Productos
    </a>

    <a href="/stock">
      Stock
    </a>

    <a href="/transferencias">
      Transferencias
    </a>

    <a href="/ingresos">
      Ingreso de mercadería
    </a>

    <div class="separator"></div>

    <a href="/reportes">
      Reportes
    </a>

    <a href="/movimientos">
      Historial
    </a>

  </aside>

  <main class="content">

    <div class="page-header">

      <div>

        <h2>
          Productos
        </h2>

        <p>
          Catálogo general de La Torre
        </p>

      </div>

      <% if (usuario.rol === "dueno") { %>

        <a
          href="/productos/nuevo"
          class="btn btn-primary"
        >
          + Nuevo producto
        </a>

      <% } %>

    </div>

    <form
      class="filters"
      method="GET"
      action="/productos"
    >

      <input
        class="search"
        type="search"
        name="buscar"
        value="<%= buscar %>"
        placeholder="Buscar por descripción, código, código de barras, marca o categoría..."
        autofocus
      >

      <select name="marca"><option value="">Todas las marcas</option><% (filtros.marcas || []).forEach(x => { %><option value="<%= x %>" <%= marca===x?'selected':'' %>><%= x %></option><% }) %></select>
      <select name="proveedor"><option value="">Todos los proveedores</option><% (filtros.proveedores || []).forEach(x => { %><option value="<%= x %>" <%= proveedor===x?'selected':'' %>><%= x %></option><% }) %></select>
      <select name="categoria"><option value="">Todas las categorías</option><% (filtros.categorias || []).forEach(x => { %><option value="<%= x %>" <%= categoria===x?'selected':'' %>><%= x %></option><% }) %></select>

      <select name="estado">

        <option
          value="activos"
          <%= estado === "activos" ? "selected" : "" %>
        >
          Productos activos
        </option>

        <option
          value="inactivos"
          <%= estado === "inactivos" ? "selected" : "" %>
        >
          Productos inactivos
        </option>

      </select>

      <button
        class="btn btn-primary"
        type="submit"
      >
        Buscar
      </button>

      <% if (buscar || marca || proveedor || categoria) { %>

        <a
          href="/productos?estado=<%= estado %>"
          class="btn btn-light"
        >
          Limpiar
        </a>

      <% } %>

    </form>

    <% if (usuario.rol === "dueno") { %>
    <section class="table-card" style="padding:16px;margin-bottom:16px;">
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;">
        <div><strong>Edición masiva de precios</strong><div class="muted">Tildá productos y aplicá el cambio.</div></div>
        <select id="masivoCampo"><option value="precio_efectivo">Efectivo</option><option value="precio_tarjeta">Tarjeta</option><option value="precio_compra">Compra</option></select>
        <select id="masivoOperacion"><option value="porcentaje">Aumentar / bajar %</option><option value="sumar">Sumar / restar $</option><option value="fijar">Fijar precio</option></select>
        <input id="masivoValor" type="number" step="0.01" placeholder="Valor">
        <button class="btn btn-primary" type="button" id="aplicarMasivo">Aplicar</button>
        <button class="btn btn-light" type="button" id="seleccionarTodos">Seleccionar visibles</button>
      </div>
    </section>
    <% } %>

    <div class="table-card">

      <% if (productos.length === 0) { %>

        <div class="empty">

          No hay productos para mostrar.

        </div>

      <% } else { %>

        <div class="table-scroll">

          <table>

            <thead>

              <tr>

                <% if (usuario.rol === "dueno") { %><th>✓</th><% } %>

                <th>
                  Código
                </th>

                <th>
                  Código barras
                </th>

                <th>
                  Producto
                </th>

                <th>
                  Categoría
                </th>

                <th>
                  Marca
                </th>

                <th>Proveedor</th>

                <th>
                  Compra
                </th>

                <th>
                  Efectivo
                </th>

                <th>
                  Tarjeta
                </th>

                <th>Florida Local</th>
                <th>Dep. Florida</th>
                <th>Delfín Gallo Local</th>
                <th>Dep. Delfín Gallo</th>

                <th>
                  Total
                </th>

                <% if (usuario.rol === "dueno") { %>

                  <th>
                    Acciones
                  </th>

                <% } %>

              </tr>

            </thead>

            <tbody>

              <% productos.forEach(producto => { %>

                <tr>

                  <% if (usuario.rol === "dueno") { %><td><input type="checkbox" class="seleccionar-producto" value="<%= producto.id %>"></td><% } %>

                  <td>
                    <%= producto.codigo_interno || "-" %>
                  </td>

                  <td>
                    <%= producto.codigo_barras || "-" %>
                  </td>

                  <td>

                    <div class="producto">
                      <%= producto.descripcion %>
                    </div>

                    <% if (producto.ubicacion_deposito) { %>

                      <div class="muted">
                        Depósito:
                        <%= producto.ubicacion_deposito %>
                      </div>

                    <% } %>

                  </td>

                  <td>
                    <%= producto.categoria || "-" %>
                  </td>

                  <td>
                    <%= producto.marca || "-" %>
                  </td>

                  <td><%= producto.proveedor || "-" %></td>

                  <td class="precio">

                    <% if (usuario.rol === "dueno") { %><input class="precio-rapido" data-id="<%= producto.id %>" data-campo="precio_compra" type="number" step="0.01" min="0" value="<%= Number(producto.precio_compra) %>" style="width:110px"><% } else { %>$<%= Number(producto.precio_compra).toLocaleString("es-AR", {minimumFractionDigits:2,maximumFractionDigits:2}) %><% } %>

                  </td>

                  <td class="precio">

                    <% if (usuario.rol === "dueno") { %><input class="precio-rapido" data-id="<%= producto.id %>" data-campo="precio_efectivo" type="number" step="0.01" min="0" value="<%= Number(producto.precio_efectivo) %>" style="width:110px"><% } else { %>$<%= Number(producto.precio_efectivo).toLocaleString("es-AR", {minimumFractionDigits:2,maximumFractionDigits:2}) %><% } %>

                  </td>

                  <td class="precio">

                    <% if (usuario.rol === "dueno") { %><input class="precio-rapido" data-id="<%= producto.id %>" data-campo="precio_tarjeta" type="number" step="0.01" min="0" value="<%= Number(producto.precio_tarjeta) %>" style="width:110px"><% } else { %>$<%= Number(producto.precio_tarjeta).toLocaleString("es-AR", {minimumFractionDigits:2,maximumFractionDigits:2}) %><% } %>

                  </td>

                  <td class="stock"><%= Number(producto.stock_florida) %></td>
                  <td class="stock"><%= Number(producto.stock_deposito_florida) %></td>
                  <td class="stock"><%= Number(producto.stock_delfin) %></td>
                  <td class="stock"><%= Number(producto.stock_deposito_delfin) %></td>

                  <td class="stock">

                    <span class="stock-total">
                      <%= Number(producto.stock_total) %>
                    </span>

                  </td>

                  <% if (usuario.rol === "dueno") { %>

                    <td>

                      <div class="acciones">

                        <a
                          class="btn btn-light btn-small"
                          href="/productos/<%= producto.id %>/editar"
                        >
                          Editar
                        </a>

                        <form
                          action="/productos/<%= producto.id %>/estado"
                          method="POST"
                        >

                          <button
                            class="btn btn-danger btn-small"
                            type="submit"
                          >

                            <% if (producto.activo) { %>

                              Desactivar

                            <% } else { %>

                              Activar

                            <% } %>

                          </button>

                        </form>

                      </div>

                    </td>

                  <% } %>

                </tr>

              <% }) %>

            </tbody>

          </table>

        </div>

      <% } %>

    </div>

  </main>

</div>

<script>
(()=>{
 document.querySelectorAll('.precio-rapido').forEach(input=>input.addEventListener('keydown',async e=>{if(e.key!=='Enter')return;e.preventDefault();const r=await fetch(`/productos/${input.dataset.id}/precio-rapido`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({campo:input.dataset.campo,valor:Number(input.value)})});const d=await r.json();if(!d.ok)return alert(d.error||'No se pudo guardar');input.blur();}));
 const t=document.getElementById('seleccionarTodos');if(t)t.onclick=()=>document.querySelectorAll('.seleccionar-producto').forEach(x=>x.checked=true);
 const a=document.getElementById('aplicarMasivo');if(a)a.onclick=async()=>{const ids=[...document.querySelectorAll('.seleccionar-producto:checked')].map(x=>Number(x.value));if(!ids.length)return alert('Seleccioná al menos un producto.');const valor=Number(document.getElementById('masivoValor').value);if(!Number.isFinite(valor))return alert('Ingresá un valor.');if(!confirm(`¿Aplicar el cambio a ${ids.length} producto(s)?`))return;const r=await fetch('/productos/precios-masivos',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids,campo:document.getElementById('masivoCampo').value,operacion:document.getElementById('masivoOperacion').value,valor})});const d=await r.json();if(!d.ok)return alert(d.error||'Error');location.reload();};
})();
</script>
</body>

</html>