<!doctype html><html lang="es"><head><meta charset="utf-8"><title>Ticket #<%=venta.numero%></title><style>@page{size:80mm auto;margin:4mm}body{font-family:Arial;width:72mm;margin:auto;font-size:12px;color:#000}.center{text-align:center}.logo{width:34mm}.line{border-top:1px dashed #000;margin:8px 0}.r{display:flex;justify-content:space-between;gap:8px}.total{font-size:17px;font-weight:bold}.no-print{margin:10px 0}@media print{.no-print{display:none}}</style></head><body><div class="no-print"><button onclick="print()">Imprimir ticket</button></div><div class="center"><img class="logo" src="/images/logo-la-torre.png"><h2>LA TORRE</h2><div><%=direccion%></div><div>Tel. <%=empresa.telefono%></div></div><div class="line"></div><div>Venta #<%=venta.numero%></div><div><%=new Date(venta.created_at).toLocaleString('es-AR')%></div><div><%=venta.vendedor%></div><div class="line"></div><%items.forEach(i=>{%><div><b><%=i.descripcion%></b></div><div class="r"><span><%=Number(i.cantidad)%> x $<%=Number(i.precio_unitario).toLocaleString('es-AR')%></span><span>$<%=Number(i.subtotal).toLocaleString('es-AR')%></span></div><%})%><div class="line"></div><div class="r total"><span>TOTAL</span><span>$<%=Number(venta.total).toLocaleString('es-AR')%></span></div><div>Pago: <%=venta.forma_pago||'-'%></div><div class="line"></div><div class="center">Gracias por su compra<br><%=empresa.instagram%></div></body></html>
