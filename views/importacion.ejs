<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    La Torre | Importación inicial
  </title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f3f4f6;
      color: #111827;
      font-family: "Segoe UI", Arial, sans-serif;
    }

    .topbar {
      min-height: 72px;
      background: #111827;
      color: white;
      padding: 0 26px;

      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand h1 {
      margin: 0;
      font-size: 24px;
    }

    .brand span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .usuario {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .usuario-info {
      text-align: right;
    }

    .usuario-info strong {
      display: block;
      font-size: 14px;
    }

    .usuario-info span {
      display: block;
      margin-top: 3px;
      color: #9ca3af;
      font-size: 12px;
    }

    .logout {
      border: 1px solid #374151;
      border-radius: 9px;
      padding: 9px 12px;
      background: #1f2937;
      color: white;
      cursor: pointer;
    }

    .layout {
      display: flex;
      min-height: calc(100vh - 72px);
    }

    .sidebar {
      width: 235px;
      flex-shrink: 0;
      background: white;
      border-right: 1px solid #e5e7eb;
      padding: 20px 14px;
    }

    .sidebar a {
      display: block;
      margin-bottom: 5px;
      padding: 12px 14px;
      border-radius: 9px;
      text-decoration: none;
      color: #374151;
      font-size: 14px;
      font-weight: 600;
    }

    .sidebar a:hover {
      background: #f3f4f6;
    }

    .sidebar a.active {
      background: #111827;
      color: white;
    }

    .separator {
      height: 1px;
      margin: 14px 8px;
      background: #e5e7eb;
    }

    .content {
      flex: 1;
      min-width: 0;
      padding: 28px;
    }

    .page-header h2 {
      margin: 0;
      font-size: 28px;
    }

    .page-header p {
      margin: 7px 0 0;
      color: #6b7280;
    }

    .alert {
      margin-top: 18px;
      padding: 14px 16px;
      border-radius: 10px;
      font-size: 14px;
      line-height: 1.5;
    }

    .alert-error {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }

    .alert-info {
      background: #eff8ff;
      color: #175cd3;
      border: 1px solid #b2ddff;
    }

    .mapping {
      margin-top: 18px;
      padding: 17px;
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 14px;

      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .map-card {
      padding: 15px;
      background: #f9fafb;
      border-radius: 10px;
    }

    .map-card span {
      display: block;
      color: #6b7280;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .map-card strong {
      display: block;
      margin-top: 6px;
      font-size: 16px;
    }

    .import-card {
      margin-top: 18px;
      max-width: 750px;

      background: white;

      border: 1px solid #e5e7eb;
      border-radius: 15px;

      padding: 22px;
    }

    .import-card h3 {
      margin: 0 0 8px;
    }

    .import-card p {
      margin: 0 0 20px;
      color: #6b7280;
      font-size: 14px;
      line-height: 1.5;
    }

    .file-box {
      padding: 22px;

      border:
        2px dashed #d1d5db;

      border-radius: 12px;

      background: #f9fafb;
    }

    .file-box label {
      display: block;
      margin-bottom: 9px;
      font-weight: 700;
    }

    input[type="file"] {
      width: 100%;
    }

    .btn {
      min-height: 46px;
      margin-top: 18px;
      padding: 0 20px;

      border: none;
      border-radius: 10px;

      background: #111827;
      color: white;

      font-size: 14px;
      font-weight: 800;

      cursor: pointer;
    }

    .btn:disabled {
      opacity: .5;
      cursor: not-allowed;
    }

    .warning {
      margin-top: 18px;
      padding: 14px;

      border-radius: 10px;

      background: #fff7ed;
      color: #9a3412;

      border: 1px solid #fed7aa;

      font-size: 13px;
      line-height: 1.5;
    }

    .resultado {
      margin-top: 22px;

      background: white;

      border: 1px solid #e5e7eb;
      border-radius: 15px;

      padding: 22px;
    }

    .resultado h3 {
      margin-top: 0;
      color: #067647;
    }

    .result-grid {
      display: grid;
      grid-template-columns:
        repeat(4, 1fr);
      gap: 12px;
    }

    .result-item {
      padding: 14px;
      background: #f9fafb;
      border-radius: 10px;
    }

    .result-item span {
      display: block;
      color: #6b7280;
      font-size: 11px;
      font-weight: 700;
    }

    .result-item strong {
      display: block;
      margin-top: 5px;
      font-size: 20px;
    }

    .advertencias {
      margin-top: 20px;
    }

    .advertencias h4 {
      margin-bottom: 10px;
    }

    .advertencias ul {
      margin: 0;
      padding-left: 20px;
      color: #6b7280;
      font-size: 13px;
    }

    .links {
      margin-top: 20px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .link {
      padding: 10px 14px;
      border-radius: 9px;
      background: #111827;
      color: white;
      text-decoration: none;
      font-weight: 700;
      font-size: 13px;
    }

    @media(max-width:900px) {

      .mapping,
      .result-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }

    @media(max-width:760px) {

      .sidebar {
        display: none;
      }

      .content {
        padding: 18px;
      }

      .topbar {
        padding: 14px 18px;
      }

      .mapping,
      .result-grid {
        grid-template-columns: 1fr;
      }

    }

  </style>

</head>

<body>

<header class="topbar">

  <div class="brand">

    <h1>
      LA TORRE
    </h1>

    <span>
      Sistema Multisucursal
    </span>

  </div>

  <div class="usuario">

    <div class="usuario-info">

      <strong>
        <%= usuario.nombre %>
      </strong>

      <span>
        Dueño · Todas las ubicaciones
      </span>

    </div>

    <form
      action="/logout"
      method="POST"
    >

      <button
        class="logout"
        type="submit"
      >
        Salir
      </button>

    </form>

  </div>

</header>

<div class="layout">

  <aside class="sidebar">

    <a href="/dashboard">
      Inicio
    </a>

    <a href="/caja">
      Caja
    </a>

    <a href="/ventas">
      Ventas
    </a>

    <a href="/presupuestos">
      Presupuestos
    </a>

    <div class="separator"></div>

    <a href="/productos">
      Productos
    </a>

    <a href="/stock">
      Stock
    </a>

    <a href="/transferencias">
      Transferencias
    </a>

    <a href="/ingresos">
      Ingreso de mercadería
    </a>

    <div class="separator"></div>

    <a href="/reportes">
      Reportes
    </a>

    <a href="/movimientos">
      Historial
    </a>

    <a href="/tarjetas">
      Tarjetas y cuotas
    </a>

    <a
      href="/importacion"
      class="active"
    >
      Importación inicial
    </a>

  </aside>

  <main class="content">

    <div class="page-header">

      <h2>
        Importación inicial
      </h2>

      <p>
        Cargar al sistema el Excel histórico de La Torre.
      </p>

    </div>

    <% if (error) { %>

      <div class="alert alert-error">
        <%= error %>
      </div>

    <% } %>

    <div class="alert alert-info">

      Este importador está preparado específicamente para
      el Excel actual de La Torre. La hoja
      <strong>Local</strong> corresponde a
      <strong>Florida</strong>.

    </div>

    <section class="mapping">

      <div class="map-card">

        <span>
          Excel
        </span>

        <strong>
          Depósito → Depósito
        </strong>

      </div>

      <div class="map-card">

        <span>
          Excel
        </span>

        <strong>
          Local → Florida
        </strong>

      </div>

      <div class="map-card">

        <span>
          Nuevo local
        </span>

        <strong>
          Delfín Gallo → 0
        </strong>

      </div>

    </section>

    <% if (!resultado) { %>

      <section class="import-card">

        <h3>
          Importar archivo Excel
        </h3>

        <p>
          Se importarán productos, categorías, marcas,
          precios, stock inicial de Florida y Depósito,
          tarjetas y configuraciones de cuotas.
        </p>

        <form
          action="/importacion/excel"
          method="POST"
          enctype="multipart/form-data"
          onsubmit="return confirmarImportacion();"
        >

          <div class="file-box">

            <label>
              Archivo .xlsx
            </label>

            <input
              type="file"
              name="archivo"
              accept=".xlsx,.xlsm"
              required
            >

          </div>

          <button
            type="submit"
            class="btn"
          >
            Importar Excel de La Torre
          </button>

        </form>

        <div class="warning">

          <strong>Importante:</strong>
          esta función es para la carga inicial.
          Una vez que existan ventas o movimientos,
          el sistema bloqueará nuevas importaciones de stock
          para evitar alterar el inventario real.

        </div>

      </section>

    <% } %>

    <% if (resultado) { %>

      <section class="resultado">

        <h3>
          ✓ Importación completada
        </h3>

        <div class="result-grid">

          <div class="result-item">

            <span>
              PRODUCTOS NUEVOS
            </span>

            <strong>
              <%= resultado.productosCreados %>
            </strong>

          </div>

          <div class="result-item">

            <span>
              ACTUALIZADOS
            </span>

            <strong>
              <%= resultado.productosActualizados %>
            </strong>

          </div>

          <div class="result-item">

            <span>
              STOCK FLORIDA
            </span>

            <strong>
              <%= resultado.stockFloridaTotal %>
            </strong>

          </div>

          <div class="result-item">

            <span>
              STOCK DEPÓSITO
            </span>

            <strong>
              <%= resultado.stockDepositoTotal %>
            </strong>

          </div>

          <div class="result-item">

            <span>
              STOCK DELFÍN GALLO
            </span>

            <strong>
              <%= resultado.stockDelfinTotal %>
            </strong>

          </div>

          <div class="result-item">

            <span>
              TARJETAS NUEVAS
            </span>

            <strong>
              <%= resultado.tarjetasCreadas %>
            </strong>

          </div>

          <div class="result-item">

            <span>
              PLANES DE CUOTAS
            </span>

            <strong>
              <%= resultado.cuotasImportadas %>
            </strong>

          </div>

          <div class="result-item">

            <span>
              FILAS IGNORADAS
            </span>

            <strong>
              <%= resultado.filasIgnoradas %>
            </strong>

          </div>

        </div>

        <% if (
          resultado.advertencias &&
          resultado.advertencias.length > 0
        ) { %>

          <div class="advertencias">

            <h4>
              Advertencias
            </h4>

            <ul>

              <% resultado.advertencias.forEach(
                aviso => {
              %>

                <li>
                  <%= aviso %>
                </li>

              <% }) %>

            </ul>

          </div>

        <% } %>

        <div class="links">

          <a
            href="/productos"
            class="link"
          >
            Ver productos
          </a>

          <a
            href="/stock"
            class="link"
          >
            Ver stock
          </a>

          <a
            href="/tarjetas"
            class="link"
          >
            Ver tarjetas
          </a>

        </div>

      </section>

    <% } %>

  </main>

</div>

<script>

  function confirmarImportacion() {
    return confirm(
      "¿Confirmás la importación inicial del Excel? El stock Local será cargado en Florida y Delfín Gallo comenzará en cero."
    );
  }

</script>

</body>

</html>