<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    La Torre | Presupuesto #<%= presupuesto.numero %>
  </title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f3f4f6;
      color: #111827;
      font-family: "Segoe UI", Arial, sans-serif;
    }

    .top {
      background: #111827;
      color: white;
      padding: 20px 28px;
    }

    .top h1 {
      margin: 0;
    }

    .container {
      max-width: 1050px;
      margin: 30px auto;
      padding: 0 20px 50px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 20px;
    }

    .header h2 {
      margin: 0;
    }

    .back {
      text-decoration: none;
      color: #374151;
      font-weight: 700;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 18px;
    }

    .card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 15px;
      padding: 20px;
    }

    .info {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .info span {
      display: block;
      color: #6b7280;
      font-size: 11px;
      font-weight: 700;
    }

    .info strong {
      display: block;
      margin-top: 5px;
    }

    table {
      width: 100%;
      margin-top: 18px;
      border-collapse: collapse;
      background: white;
    }

    th,
    td {
      padding: 12px;
      border-bottom: 1px solid #e5e7eb;
      text-align: left;
      font-size: 13px;
    }

    th {
      background: #f9fafb;
      color: #6b7280;
      font-size: 11px;
    }

    .fila {
      display: flex;
      justify-content: space-between;
      margin: 11px 0;
    }

    .total {
      border-top: 2px solid #111827;
      padding-top: 15px;
      margin-top: 15px;
      font-size: 24px;
      font-weight: 900;
    }

    label {
      display: block;
      margin: 13px 0 7px;
      font-size: 13px;
      font-weight: 700;
    }

    select {
      width: 100%;
      min-height: 42px;
      border: 1px solid #d1d5db;
      border-radius: 9px;
      padding: 8px 10px;
      background: white;
    }

    .tarjeta-box {
      display: none;
    }

    .btn {
      width: 100%;
      min-height: 45px;
      margin-top: 15px;
      border: none;
      border-radius: 9px;
      font-weight: 800;
      cursor: pointer;
    }

    .btn-primary {
      background: #111827;
      color: white;
    }

    .btn-danger {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }

    .estado {
      display: inline-block;
      padding: 6px 9px;
      border-radius: 7px;
      background: #f3f4f6;
      font-weight: 800;
      text-transform: capitalize;
    }

    .alert {
      padding: 12px 15px;
      border-radius: 9px;
      margin-bottom: 18px;
    }

    .ok {
      background: #ecfdf3;
      color: #067647;
    }

    .error {
      background: #fef2f2;
      color: #b91c1c;
    }

    @media(max-width:760px) {

      .grid,
      .info {
        grid-template-columns: 1fr;
      }

    }

  </style>

</head>

<body>
<div style="position:fixed;right:22px;bottom:22px;z-index:999;display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;">
<a href="/presupuestos/<%= presupuesto.id %>/comprobante" target="_blank" style="padding:10px 13px;background:#111827;color:white;text-decoration:none;border-radius:9px;font-weight:700;">A4 / Imprimir</a>
<a href="/presupuestos/<%= presupuesto.id %>/pdf" target="_blank" style="padding:10px 13px;background:#111827;color:white;text-decoration:none;border-radius:9px;font-weight:700;">PDF</a>
<a href="/presupuestos/<%= presupuesto.id %>/whatsapp" target="_blank" style="padding:10px 13px;background:#16a34a;color:white;text-decoration:none;border-radius:9px;font-weight:700;">WhatsApp</a>
</div>

<header class="top">

  <h1>
    LA TORRE
  </h1>

</header>

<main class="container">

  <div class="header">

    <div>

      <h2>
        Presupuesto #<%= presupuesto.numero %>
      </h2>

      <p>
        <%= new Date(
          presupuesto.created_at
        ).toLocaleString(
          "es-AR"
        ) %>
      </p>

    </div>

    <a
      href="/presupuestos"
      class="back"
    >
      ← Volver
    </a>

  </div>

  <% if (mensaje) { %>

    <div class="alert ok">
      <%= mensaje %>
    </div>

  <% } %>

  <% if (error) { %>

    <div class="alert error">
      <%= error %>
    </div>

  <% } %>

  <div class="grid">

    <div>

      <section class="card">

        <div class="info">

          <div>

            <span>
              CLIENTE
            </span>

            <strong>
              <%= presupuesto.cliente_nombre %>
            </strong>

          </div>

          <div>

            <span>
              ESTADO
            </span>

            <strong>
              <span class="estado">
                <%= presupuesto.estado %>
              </span>
            </strong>

          </div>

          <div>

            <span>
              SUCURSAL
            </span>

            <strong>
              <%= presupuesto.ubicacion %>
            </strong>

          </div>

          <div>

            <span>
              VENDEDOR
            </span>

            <strong>
              <%= presupuesto.vendedor %>
            </strong>

          </div>

          <div>

            <span>
              DNI / CUIT
            </span>

            <strong>
              <%= presupuesto.cliente_documento || "-" %>
            </strong>

          </div>

          <div>

            <span>
              TELÉFONO
            </span>

            <strong>
              <%= presupuesto.cliente_telefono || "-" %>
            </strong>

          </div>

        </div>

      </section>

      <section class="card" style="margin-top:18px;">

        <h3>
          Productos
        </h3>

        <table>

          <thead>

            <tr>

              <th>Producto</th>
              <th>Cantidad</th>
              <th>Precio</th>
              <th>Subtotal</th>

            </tr>

          </thead>

          <tbody>

            <% items.forEach(
              item => {
            %>

              <tr>

                <td>

                  <strong>
                    <%= item.descripcion %>
                  </strong>

                  <div style="
                    margin-top:4px;
                    color:#9ca3af;
                    font-size:11px;
                  ">
                    <%= item.codigo_interno || item.codigo_barras || "-" %>
                  </div>

                </td>

                <td>
                  <%= Number(item.cantidad) %>
                </td>

                <td>
                  $<%= Number(
                    item.precio_unitario
                  ).toLocaleString(
                    "es-AR"
                  ) %>
                </td>

                <td>
                  <strong>
                    $<%= Number(
                      item.subtotal
                    ).toLocaleString(
                      "es-AR"
                    ) %>
                  </strong>
                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </section>

    </div>

    <aside class="card">

      <h3>
        Resumen
      </h3>

      <div class="fila">

        <span>
          Subtotal
        </span>

        <strong>
          $<%= Number(
            presupuesto.subtotal
          ).toLocaleString(
            "es-AR"
          ) %>
        </strong>

      </div>

      <div class="fila">

        <span>
          Descuento
        </span>

        <strong>
          - $<%= Number(
            presupuesto.descuento
          ).toLocaleString(
            "es-AR"
          ) %>
        </strong>

      </div>

      <div class="fila">

        <span>
          Recargo
        </span>

        <strong>
          + $<%= Number(
            presupuesto.recargo
          ).toLocaleString(
            "es-AR"
          ) %>
        </strong>

      </div>

      <div class="fila total">

        <span>
          TOTAL
        </span>

        <strong>
          $<%= Number(
            presupuesto.total
          ).toLocaleString(
            "es-AR"
          ) %>
        </strong>

      </div>

      <% if (
        presupuesto.estado === "activo"
      ) { %>

        <form
          action="/presupuestos/<%= presupuesto.id %>/convertir"
          method="POST"
          id="formConvertir"
        >

          <label>
            Forma de pago
          </label>

          <select
            id="formaPago"
            name="forma_pago_id"
            required
          >

            <option
              value=""
              data-tipo=""
            >
              Seleccionar...
            </option>

            <% formasPago.forEach(
              forma => {
            %>

              <option
                value="<%= forma.id %>"
                data-tipo="<%= forma.tipo %>"
              >
                <%= forma.nombre %>
              </option>

            <% }) %>

          </select>

          <div
            id="tarjetaBox"
            class="tarjeta-box"
          >

            <label>
              Tarjeta
            </label>

            <select
              id="tarjeta"
              name="tarjeta_id"
            >

              <option value="">
                Seleccionar...
              </option>

              <% tarjetas.forEach(
                tarjeta => {
              %>

                <option value="<%= tarjeta.id %>">
                  <%= tarjeta.nombre %>
                </option>

              <% }) %>

            </select>

            <label>
              Cuotas
            </label>

            <select
              id="cuotas"
              name="cuotas"
            >

              <option value="">
                Seleccionar...
              </option>

            </select>

          </div>

          <button
            class="btn btn-primary"
            type="submit"
          >
            Convertir en venta
          </button>

        </form>

        <form
          action="/presupuestos/<%= presupuesto.id %>/cancelar"
          method="POST"
          onsubmit="return confirm('¿Cancelar este presupuesto?');"
        >

          <button
            class="btn btn-danger"
            type="submit"
          >
            Cancelar presupuesto
          </button>

        </form>

      <% } %>

      <% if (
        presupuesto.observaciones
      ) { %>

        <div style="
          margin-top:22px;
          color:#6b7280;
          white-space:pre-line;
          font-size:13px;
        ">

          <strong>
            Observaciones
          </strong>

          <br><br>

          <%= presupuesto.observaciones %>

        </div>

      <% } %>

    </aside>

  </div>

</main>

<script>

  const formaPago =
    document.getElementById(
      "formaPago"
    );

  const tarjetaBox =
    document.getElementById(
      "tarjetaBox"
    );

  const tarjeta =
    document.getElementById(
      "tarjeta"
    );

  const cuotas =
    document.getElementById(
      "cuotas"
    );

  if (formaPago) {

    formaPago.onchange =
      () => {

        const option =
          formaPago.options[
            formaPago.selectedIndex
          ];

        const tipo =
          option.dataset.tipo;

        tarjetaBox.style.display =
          tipo === "tarjeta"
            ? "block"
            : "none";

      };

  }

  if (tarjeta) {

    tarjeta.onchange =
      async () => {

        cuotas.innerHTML =
          '<option value="">Seleccionar...</option>';

        if (!tarjeta.value) {
          return;
        }

        const response =
          await fetch(
            `/presupuestos/api/tarjetas/${tarjeta.value}/cuotas`
          );

        const lista =
          await response.json();

        lista.forEach(
          item => {

            const option =
              document.createElement(
                "option"
              );

            option.value =
              item.cuotas;

            option.textContent =
              `${item.cuotas} cuotas · ${item.recargo_porcentaje}%`;

            cuotas.appendChild(
              option
            );

          }
        );

      };

  }

</script>

</body>
</html>