<!doctype html><html lang="es"><head><meta charset="utf-8"><title>Comprobante venta #<%=venta.numero%></title><style>@page{size:A4;margin:14mm}body{font-family:Arial;color:#111;margin:0}.actions{display:flex;gap:8px;margin:18px auto;max-width:900px}.btn{padding:10px 14px;border-radius:8px;background:#111827;color:#fff;text-decoration:none;border:0;cursor:pointer}.sheet{max-width:900px;margin:auto;background:#fff;padding:20px}.head{display:flex;gap:22px;align-items:center;border-bottom:2px solid #111;padding-bottom:16px}.logo{width:110px}.muted{color:#666}.meta{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:20px 0}.box{padding:10px;background:#f7f7f7;border-radius:8px}table{width:100%;border-collapse:collapse}th,td{padding:10px;border-bottom:1px solid #ddd;text-align:left}th{background:#f5f5f5}.tot{margin-left:auto;width:340px;margin-top:18px}.row{display:flex;justify-content:space-between;padding:5px 0}.grand{font-size:22px;font-weight:800;border-top:2px solid #111;padding-top:10px}.foot{text-align:center;margin-top:35px;font-size:12px;color:#666}@media print{.actions{display:none}.sheet{padding:0}}</style></head><body><div class="actions"><button class="btn" onclick="print()">Imprimir A4</button><a class="btn" href="/ventas/<%=venta.id%>/ticket">Ticket 80 mm</a><a class="btn" href="/ventas/<%=venta.id%>/pdf" target="_blank">PDF</a><a class="btn" href="/ventas/<%=venta.id%>/whatsapp" target="_blank">WhatsApp</a><a class="btn" href="/ventas/<%=venta.id%>">Volver</a></div><main class="sheet"><div class="head"><img class="logo" src="/images/logo-la-torre.png"><div><h1>LA TORRE</h1><b>ELECTRO · HOGAR</b><div class="muted"><%=direccion%><br>Tel. <%=empresa.telefono%> · <%=empresa.instagram%></div></div></div><h2>Comprobante de venta #<%=venta.numero%></h2><div class="meta"><div class="box"><b>Fecha</b><br><%=new Date(venta.created_at).toLocaleString('es-AR')%></div><div class="box"><b>Sucursal</b><br><%=venta.ubicacion%></div><div class="box"><b>Cliente</b><br><%=venta.cliente_nombre||'Consumidor final'%></div><div class="box"><b>Forma de pago</b><br><%=venta.forma_pago||'-'%></div></div><table><thead><tr><th>Producto</th><th>Cant.</th><th>Precio</th><th>Subtotal</th></tr></thead><tbody><%items.forEach(i=>{%><tr><td><%=i.descripcion%></td><td><%=Number(i.cantidad)%></td><td>$<%=Number(i.precio_unitario).toLocaleString('es-AR')%></td><td>$<%=Number(i.subtotal).toLocaleString('es-AR')%></td></tr><%})%></tbody></table><div class="tot"><div class="row"><span>Subtotal</span><b>$<%=Number(venta.subtotal).toLocaleString('es-AR')%></b></div><%if(Number(venta.descuento)>0){%><div class="row"><span>Descuento</span><b>-$<%=Number(venta.descuento).toLocaleString('es-AR')%></b></div><%}%><%if(Number(venta.recargo)>0){%><div class="row"><span>Recargo</span><b>$<%=Number(venta.recargo).toLocaleString('es-AR')%></b></div><%}%><div class="row grand"><span>TOTAL</span><span>$<%=Number(venta.total).toLocaleString('es-AR')%></span></div></div><div class="foot">Comprobante interno de venta · <%=empresa.instagram%> · <%=empresa.telefono%></div></main></body></html>
